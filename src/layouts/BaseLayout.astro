---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { baseStructuredData } from "../lib/structuredData";

const {
  title = "CertiSpares",
  description = "RFQ-first commercial vehicle aftermarket sourcing support from China.",
  keywords = [],
  canonical,
  ogImage,
  jsonLd,
  robots,
} = Astro.props;

const SITE_URL = "https://certispares.com";

const keywordsContent =
  Array.isArray(keywords) ? keywords.filter(Boolean).join(", ") : String(keywords || "");

const canonicalUrl = canonical ? new URL(canonical, SITE_URL).toString() : undefined;
const ogImageUrl = ogImage ? new URL(ogImage, SITE_URL).toString() : undefined;
const pageStructuredData = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const structuredData = [...baseStructuredData, ...pageStructuredData];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {robots && <meta name="robots" content={robots} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CertiSpares" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Work+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {structuredData.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-17FD7ZZRH6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-17FD7ZZRH6');
    </script>

    <style is:global>
      :root{
        --site-bg:#0B1020;
        --site-panel:#111A33;
        --site-text:#EAF0FF;
        --site-muted:#A8B3CF;
        --site-line:rgba(255,255,255,.08);
        --site-brand:#0A2540;
        --site-brand2:#3957E9;
        --site-accent:#3957E9;
        --site-accent-soft:#EEF5FC;
        --container-default:1360px;
        --container-narrow:1080px;
        --container-wide:1520px;
        --surface:#fff;
        --surface-muted:#F7F9FC;
        --surface-text:#1d2a36;
        --surface-muted-text:#667085;
        --surface-border:#DFE6E9;
        --surface-shadow:0 8px 20px rgba(10,37,64,.04);
        --surface-shadow-hover:0 14px 34px rgba(10,37,64,.08);
        --text-primary:#1d2a36;
        --text-secondary:#667085;
        --border:#DFE6E9;
        --button-primary:#0A2540;
        --button-secondary:#3957E9;
        --button-outline:#F1F4F8;
        --space-1:4px;
        --space-2:8px;
        --space-3:12px;
        --space-4:16px;
        --space-5:20px;
        --space-6:24px;
        --space-8:32px;
        --space-10:40px;
        --space-12:48px;
        --space-14:56px;
        --space-16:64px;
        --space-20:80px;
        --radius-card:8px;
        --radius-sm:8px;
        --radius-md:12px;
        --radius-pill:999px;
      }

      *{
        box-sizing:border-box;
      }

      html,body{
        margin:0;
        padding:0;
        background:var(--site-bg);
        color:var(--site-text);
        font-family:"Inter", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        text-rendering:optimizeLegibility;
        -webkit-font-smoothing:antialiased;
        -moz-osx-font-smoothing:grayscale;
        overflow-x:hidden;
      }

      a{
        color:inherit;
        text-decoration:none;
      }

      .container{
        width:min(var(--container-default), calc(100% - 64px));
        margin:0 auto;
      }

      .container.narrow{
        width:min(var(--container-narrow), calc(100% - 64px));
      }

      .container.wide{
        width:min(var(--container-wide), calc(100% - 64px));
      }

      .btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:8px;
        min-height:46px;
        padding:0 20px;
        border-radius:8px;
        border:1px solid var(--border);
        background:var(--button-outline);
        color:var(--surface-text);
        font-size:14px;
        font-weight:800;
        letter-spacing:.04em;
        cursor:pointer;
        transition:transform .15s ease, background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
      }

      .btn.primary{
        background:var(--button-primary);
        color:#fff;
        border-color:var(--button-primary);
        box-shadow:0 10px 24px rgba(10,37,64,.14);
      }

      .btn.secondary{
        background:var(--button-secondary);
        color:#fff;
        border-color:var(--button-secondary);
      }

      .btn:hover{
        transform:translateY(-1px);
        border-color:rgba(10,37,64,.22);
      }

      .card{
        background:var(--surface);
        border:1px solid var(--surface-border);
        border-radius:var(--radius-card);
        padding:22px;
        color:var(--surface-text);
        box-shadow:var(--surface-shadow);
        transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease;
      }

      .ui-card,
      .infoCard,
      .surface-card{
        background:var(--surface);
        border:1px solid var(--surface-border);
        border-radius:var(--radius-card);
        box-shadow:var(--surface-shadow);
        color:var(--surface-text);
        transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease;
      }

      .card:hover,
      .ui-card:hover,
      .infoCard:hover,
      .surface-card:hover{
        transform:translateY(-2px);
        border-color:rgba(10,37,64,.18);
        box-shadow:var(--surface-shadow-hover);
      }

      .card b{
        display:block;
        margin-bottom:8px;
        color:var(--surface-text);
        font-family:"Work Sans", Arial, sans-serif;
        font-size:18px;
        line-height:1.35;
      }

      .card p{
        margin:0;
        color:var(--surface-muted-text);
        line-height:1.65;
      }

      h1,h2,h3,
      .title,
      .sectionTitle,
      .footerTitle{
        font-family:"Work Sans", "Arial Narrow", Arial, sans-serif;
        letter-spacing:-.025em;
      }

      .ui-badge,
      .kicker,
      .storyKicker,
      .postTag{
        font-family:"Work Sans", Arial, sans-serif;
      }

      .pageHero{
        padding:44px 0 20px;
        border-bottom:1px solid var(--site-line);
        background:radial-gradient(
          900px 420px at 25% 20%,
          rgba(47,91,255,.25),
          transparent 60%
        );
      }

      .hero:not(.homeHero),
      .pageHero{
        position:relative;
        overflow:hidden;
        isolation:isolate;
        padding:0 !important;
        border-bottom:1px solid rgba(255,255,255,.10) !important;
        background:#0b1020;
      }

      .hero:not(.homeHero) > .container:not(:has(.heroInner)),
      .pageHero > .container:not(:has(.heroInner)),
      .pageHero > .contentWrap:not(:has(.heroInner)){
        padding-top:56px !important;
        padding-bottom:46px !important;
      }

      .hero:not(.homeHero) .heroInner,
      .pageHero .heroInner{
        padding-top:56px !important;
        padding-bottom:46px !important;
        gap:24px !important;
        align-items:center !important;
      }

      .hero:not(.homeHero) .heroBg,
      .pageHero::before{
        filter:saturate(.95) contrast(.98) brightness(.82) !important;
      }

      .hero:not(.homeHero) .overlay,
      .pageHero::after{
        background:
          linear-gradient(180deg, rgba(11,16,32,.34) 0%, rgba(11,16,32,.82) 72%, rgba(11,16,32,1) 100%),
          radial-gradient(900px 420px at 25% 20%, rgba(57,87,233,.20), transparent 60%) !important;
      }

      .hero:not(.homeHero) .kicker,
      .hero:not(.homeHero) .eyebrow,
      .pageHero .kicker,
      .pageHero .eyebrow{
        margin:0 0 12px !important;
        color:rgba(234,240,255,.78) !important;
        font-family:"Work Sans", Arial, sans-serif;
        font-size:12px !important;
        font-weight:800 !important;
        letter-spacing:.14em !important;
        line-height:1.2 !important;
        text-transform:uppercase !important;
      }

      .hero:not(.homeHero) h1,
      .hero:not(.homeHero) .title,
      .pageHero h1,
      .pageHero .title{
        margin:0 0 14px !important;
        max-width:860px;
        color:#fff !important;
        font-family:"Work Sans", "Arial Narrow", Arial, sans-serif;
        font-size:clamp(38px, 4.1vw, 54px) !important;
        font-weight:700;
        letter-spacing:-.025em !important;
        line-height:1.06 !important;
      }

      .hero:not(.homeHero) .sub,
      .hero:not(.homeHero) .lead,
      .hero:not(.homeHero) .heroLead,
      .pageHero .sub,
      .pageHero .lead,
      .pageHero .heroLead{
        margin:0 !important;
        max-width:820px;
        color:rgba(234,240,255,.84) !important;
        font-size:16px;
        line-height:1.75 !important;
      }

      .hero:not(.homeHero) .heroPanel,
      .hero:not(.homeHero) .heroCard,
      .pageHero .heroPanel,
      .pageHero .heroCard,
      .pageHero .heroBriefItem,
      .pageHero .supportNoteItem{
        border-radius:8px !important;
        border:1px solid rgba(255,255,255,.14) !important;
        border-left:3px solid rgba(255,255,255,.72) !important;
        background:rgba(10,37,64,.72) !important;
        box-shadow:0 18px 42px rgba(0,0,0,.28) !important;
        backdrop-filter:blur(8px);
        -webkit-backdrop-filter:blur(8px);
      }

      .pageHero .container{
        position:relative;
        padding-top:0;
        padding-bottom:0;
        margin-top:0;
        margin-bottom:0;
        border-radius:0;
        background:transparent;
        border:0;
        box-shadow:none;
        backdrop-filter:none;
        -webkit-backdrop-filter:none;
      }

      .kicker{
        margin:0 0 10px;
        color:rgba(234,240,255,.78);
        font-size:12px;
        font-weight:900;
        letter-spacing:.12em;
        text-transform:uppercase;
      }

      .title{
        margin:0 0 10px;
        font-size:40px;
        line-height:1.12;
        letter-spacing:-.4px;
      }

      .sub{
        margin:0;
        max-width:980px;
        color:var(--site-muted);
        line-height:1.75;
      }

      h1{
        margin:0 0 10px;
        font-size:40px;
        letter-spacing:-.4px;
      }

      .lead{
        margin:0 0 18px;
        color:var(--site-muted);
        line-height:1.75;
        max-width:980px;
      }

      main{
        display:block;
      }

      .section{
        padding:56px 0;
      }

      .topbar{
        position:sticky;
        top:0;
        z-index:50;
        background:rgba(10,37,64,.95);
        backdrop-filter:blur(14px);
        -webkit-backdrop-filter:blur(14px);
        border-bottom:1px solid rgba(255,255,255,.10);
      }

      .navShell{
        height:74px;
        display:flex;
        align-items:center;
        justify-content:flex-start;
        gap:24px;
      }

      .brand{
        display:flex;
        align-items:center;
        gap:12px;
        font-weight:900;
        letter-spacing:.4px;
        flex:0 0 auto;
      }

      .brand img{
        height:86px;
        width:auto;
        display:block;
        filter:brightness(0) invert(1);
      }

      .menu{
        display:flex;
        align-items:center;
        gap:22px;
        margin-left:auto;
        color:rgba(234,240,255,.82);
        font-weight:750;
      }

      .menu a{
        position:relative;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-height:34px;
        padding:0;
        border:0;
        border-radius:0;
        background:transparent;
        color:inherit;
        font-size:12px;
        font-weight:800;
        letter-spacing:.075em;
        line-height:1;
        text-transform:uppercase;
        transition:color .16s ease, transform .16s ease;
      }

      .menu a:hover{
        color:#fff;
        background:transparent;
        transform:translateY(-1px);
      }

      .menu a.active{
        color:#fff;
        background:transparent;
        border:0;
      }

      .menu a::after{
        content:"";
        position:absolute;
        left:0;
        right:0;
        bottom:-8px;
        height:1.5px;
        background:#fff;
        transform:scaleX(0);
        transform-origin:left center;
        transition:transform .16s ease;
      }

      .menu a:hover::after,
      .menu a.active::after{
        transform:scaleX(1);
      }

      .navActions{
        display:flex;
        align-items:center;
        gap:10px;
        flex:0 0 auto;
      }

      .hamburger{
        display:none;
        align-items:center;
        gap:10px;
        background:rgba(255,255,255,.06);
        border:1px solid rgba(255,255,255,.10);
        color:#fff;
        padding:10px 12px;
        border-radius:8px;
        cursor:pointer;
        font-weight:900;
      }

      .hamburger:hover{
        background:rgba(255,255,255,.10);
      }

      .hamburgerText{
        font-size:14px;
        letter-spacing:.2px;
        opacity:.95;
      }

      .backdrop{
        position:fixed;
        inset:0;
        background:rgba(0,0,0,.45);
        z-index:60;
      }

      .drawer{
        position:fixed;
        top:0;
        right:0;
        height:100vh;
        width:min(86vw, 360px);
        background:#0b1630;
        z-index:70;
        box-shadow:-12px 0 30px rgba(0,0,0,.35);
        transform:translateX(100%);
        transition:transform .22s ease;
        padding:14px 14px 18px;
        border-left:1px solid rgba(255,255,255,.08);
      }

      .drawer.open{
        transform:translateX(0);
      }

      .drawerHead{
        display:flex;
        align-items:center;
        justify-content:flex-end;
        padding:6px 4px 10px;
      }

      .closeBtn{
        background:rgba(255,255,255,.10);
        color:#fff;
        border:0;
        border-radius:8px;
        padding:8px 10px;
        cursor:pointer;
      }

      .drawerNav{
        display:flex;
        flex-direction:column;
        margin-top:6px;
      }

      .drawerNav a{
        padding:12px 10px;
        border-radius:8px;
        color:rgba(255,255,255,.92);
        font-weight:700;
      }

      .drawerNav a:hover{
        background:rgba(255,255,255,.06);
      }

      .drawerNav a.active{
        color:#fff;
        background:transparent;
        border:0;
        box-shadow:inset 3px 0 0 var(--site-brand2);
      }

      .drawerCta{
        margin-top:12px;
      }

      .headerCta,
      .drawerCta a{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:8px;
        padding:10px 14px;
        border-radius:8px;
        background:var(--site-accent);
        color:#fff;
        font-weight:900;
        border:1px solid rgba(255,255,255,.12);
        white-space:nowrap;
      }

      .navCta{
        min-height:40px;
        padding:0 16px;
        background:#2365ff;
        box-shadow:0 10px 22px rgba(35,101,255,.18);
      }

      .navCta:hover{
        transform:translateY(-1px);
        background:#2f6bff;
      }

      .whatsappCta{
        background:#18b66a;
        border-color:rgba(255,255,255,.14);
        box-shadow:0 10px 22px rgba(24,182,106,.22);
      }

      .whatsappCta:hover{
        background:#11985a;
      }
      .whatsappLogo{
        width:18px;
        height:18px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        flex:0 0 18px;
      }

      .whatsappLogo svg{
        width:18px;
        height:18px;
        display:block;
        fill:currentColor;
      }
      .drawerCta a{
        display:flex;
        width:100%;
        text-align:center;
      }

      .footerWrap{
        border-top:1px solid rgba(255,255,255,.08);
        margin-top:0;
        background:linear-gradient(180deg, #071226 0%, #030914 100%);
        color:rgba(234,240,255,.74);
      }

      .footerShell{
        margin-top:0;
        padding:42px 0;
        color:rgba(234,240,255,.72);
        display:grid;
        grid-template-columns:minmax(260px, .95fr) minmax(420px, 1.35fr);
        gap:32px;
        align-items:start;
      }

      .footerMeta{
        display:grid;
        gap:9px;
        max-width:560px;
      }

      .footerTitle{
        color:#fff;
        font-weight:800;
      }

      .footerSocial{
        display:flex;
        gap:6px;
        margin-top:6px;
      }

      .socialIcon{
        width:30px;
        height:30px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        border:1px solid rgba(255,255,255,.12);
        background:rgba(255,255,255,.06);
        color:#fff;
        transition:transform .15s ease, background .15s ease, border-color .15s ease;
      }

      .socialIcon:hover{
        transform:translateY(-1px);
        background:rgba(35,101,255,.22);
        border-color:rgba(255,255,255,.20);
      }

      .socialIcon svg{
        width:13px;
        height:13px;
        display:block;
      }

      .footerNav{
        display:grid;
        grid-template-columns:repeat(3, minmax(0, 1fr));
        gap:12px 24px;
      }

      .footerNav a{
        display:block;
        padding:0 0 8px;
        border:0;
        background:transparent;
        border-bottom:1px solid rgba(255,255,255,.10);
      }

      .footerNav a:hover strong{
        color:#fff;
      }

      .footerNav strong{
        display:block;
        color:rgba(255,255,255,.92);
        font-size:14px;
        margin-bottom:4px;
      }

      .footerNav span{
        display:block;
        font-size:12px;
        line-height:1.55;
        color:rgba(234,240,255,.64);
      }

      @media (max-width:980px){
        h1,
        .title{
          font-size:clamp(30px, 8.8vw, 34px) !important;
          line-height:1.12;
          max-width:100%;
          overflow-wrap:break-word;
        }

        p,
        li,
        .sub,
        .lead,
        .sectionDesc,
        .heroLead{
          max-width:100%;
          overflow-wrap:break-word;
        }

        .container,
        .container.narrow,
        .container.wide,
        .contentWrap{
          width:min(calc(100% - 32px), var(--container-default)) !important;
          max-width:calc(100% - 32px);
        }

        .heroInner,
        .grid,
        .grid2,
        .grid3,
        .grid4,
        .processGrid,
        .entryChoiceGrid,
        .entryTileGrid,
        .catGrid,
        .benchmarkGrid,
        .stepGrid,
        .flowGrid,
        .proofGrid,
        .caseGrid{
          min-width:0;
        }

        .card,
        .infoCard,
        .ui-card,
        .surface-card,
        .ctaBlock,
        .heroCard{
          min-width:0;
        }

        .btn,
        .linkPill,
        .pill,
        .chip{
          max-width:100%;
          white-space:normal;
          overflow-wrap:anywhere;
          text-align:center;
        }

        .pageHero .container{
          padding-top:0;
          padding-bottom:0;
          border-radius:0;
        }
        .navShell{
          height:68px;
        }

        .navCta{
          display:none;
        }
        .menu{
          display:none;
          margin-left:0;
        }
        .hamburger{
          display:inline-flex;
        }
        .brand img{
          height:64px;
        }
        .footerShell{
          grid-template-columns:1fr;
        }
        .footerNav{
          grid-template-columns:1fr;
        }
      }
    </style>

    <slot name="head" />
  </head>

  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
