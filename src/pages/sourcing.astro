const mixedListSteps = [
  {
    n: "01",
    title: "Split the List",
    text: "Brake, suspension, engine, rubber, axle, electrical, and body items are separated by sourcing reality.",
  },
  {
    n: "02",
    title: "Mark Uncertain Lines",
    text: "Unclear OE references, missing photos, duplicate descriptions, and left/right variants are flagged before pricing.",
  },
  {
    n: "03",
    title: "Group Suppliers Around Shipment Logic",
    text: "Suppliers are selected by item group, MOQ, packing, lead time, and consolidation fit.",
  },
