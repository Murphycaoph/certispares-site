---

<BaseLayout
  title="Multi-Supplier Truck Parts Sourcing | Cost and Turnover Strategy"
  description="Multi-supplier truck parts sourcing built around supplier comparison, balanced SKU sourcing, quotation consolidation, lower landed cost, turnover logic, and shipment planning."
  keywords={["truck parts sourcing strategy", "multi supplier sourcing", "container consolidation", "truck parts SKU mix", "landed cost sourcing", "inventory turnover sourcing"]}
  canonical="/sourcing/"
  ogImage="/images/sourcing/compare-container-ship.webp"
  jsonLd={jsonLd}
>
  <style>
    :root{
      --source-bg:#f3f6fb;
      --source-ink:#0d1d3d;
      --source-text:#30405d;
      --source-muted:#66738c;
      --source-line:rgba(13,29,61,.11);
      --source-blue:#2365ff;
      --source-green:#0f9f67;
      --source-navy:#071f43;
      --source-soft:#eef5ff;
      --source-danger:#c74747;
    }

    :global(main){
      background:var(--source-bg);
      color:var(--source-text);
    }

    .sourcingHero{
      position:relative;
      overflow:hidden;
      isolation:isolate;
      background:#071226;
      color:#fff;
    }

    .sourcingHero::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-2;
      background:url("/images/sourcing/compare-container-ship.webp") center/cover no-repeat;
      filter:saturate(.96) contrast(1.02) brightness(.74);
      transform:scale(1.02);
    }

    .sourcingHero::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:-1;
      background:
        linear-gradient(90deg, rgba(7,18,38,.97) 0%, rgba(7,18,38,.84) 44%, rgba(7,18,38,.50) 72%, rgba(7,18,38,.82) 100%),
        linear-gradient(180deg, rgba(7,18,38,.18) 0%, rgba(7,18,38,.90) 100%);
    }

    .heroInner{
      display:grid;
      grid-template-columns:minmax(0, 1fr) minmax(340px, 430px);
      gap:54px;
      align-items:center;
      min-height:535px;
      padding:62px 0 42px;
    }

    .eyebrow{
      margin:0 0 14px;
      color:rgba(234,240,255,.74);
      font-size:12px;
      font-weight:900;
      letter-spacing:.14em;
      text-transform:uppercase;
    }

    .heroCopy h1{
      margin:0;
      max-width:820px;
      color:#fff;
      font-size:clamp(40px, 4.4vw, 58px);
      line-height:1.05;
      letter-spacing:0;
    }

    .heroCopy h1 span,
    .sectionHeader h2 span,
    .finalCta h2 span{
      color:#52d38f;
    }

    .heroCopy p{
      margin:22px 0 0;
      max-width:760px;
      color:rgba(234,240,255,.88);
      font-size:17px;
      line-height:1.72;
    }

    .heroActions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:30px;
    }

    .actionBtn,
    .lightBtn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:9px;
      min-height:46px;
      padding:0 20px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.20);
      color:#fff;
      font-size:14px;
      font-weight:900;
      transition:transform .16s ease, background .16s ease, border-color .16s ease;
    }

    .actionBtn svg,
    .lightBtn svg{
      width:18px;
      height:18px;
      fill:none;
      stroke:currentColor;
      stroke-width:1.8;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .actionBtn.primary{
      background:#0f9f67;
      border-color:#0f9f67;
      box-shadow:0 18px 38px rgba(15,159,103,.18);
    }

    .actionBtn.secondary{
      background:rgba(255,255,255,.07);
    }

    .actionBtn:hover,
    .lightBtn:hover{
      transform:translateY(-2px);
    }

    .controlPanel{
      padding:24px;
      border:1px solid rgba(255,255,255,.18);
      border-radius:8px;
      background:rgba(7,18,38,.76);
      box-shadow:0 24px 58px rgba(0,0,0,.30);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
    }

    .controlPanel h2{
      margin:0 0 16px;
      color:#fff;
      font-size:20px;
      letter-spacing:0;
    }

    .controlList{
      display:grid;
      gap:10px;
    }

    .controlItem{
      display:grid;
      grid-template-columns:38px minmax(0, 1fr);
      gap:12px;
      align-items:start;
      padding:12px;
      border-radius:8px;
      background:rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.10);
    }

    .iconBox,
    .metricIcon,
    .gainIcon,
    .pathIcon{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:8px;
      color:var(--source-blue);
      background:#f7fbff;
      border:1px solid rgba(35,101,255,.22);
    }

    .controlItem .iconBox{
      width:38px;
      height:38px;
      color:#52d38f;
      background:rgba(82,211,143,.10);
      border-color:rgba(82,211,143,.24);
    }

    .iconBox svg,
    .metricIcon svg,
    .gainIcon svg,
    .pathIcon svg{
      width:20px;
      height:20px;
      fill:none;
      stroke:currentColor;
      stroke-width:1.75;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .controlItem strong{
      display:block;
      margin:0 0 4px;
      color:#fff;
      font-size:14px;
      line-height:1.25;
    }

    .controlItem span:last-child{
      color:rgba(234,240,255,.72);
      font-size:12px;
      line-height:1.45;
    }

    .pageBody{
      padding:26px 0 0;
    }

    .sectionBlock{
      padding:28px 0;
    }

    .sectionHeader{
      margin:0 auto 22px;
      max-width:920px;
      text-align:center;
    }

    .sectionHeader.left{
      margin-left:0;
      text-align:left;
    }

    .sectionHeader h2{
      margin:0;
      color:var(--source-ink);
      font-size:30px;
      line-height:1.16;
      letter-spacing:0;
    }

    .sectionHeader p{
      margin:10px auto 0;
      max-width:820px;
      color:var(--source-muted);
      line-height:1.65;
    }

    .sectionHeader.left p{
      margin-left:0;
    }

    .frictionGrid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:0;
      overflow:hidden;
      border:1px solid var(--source-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .frictionCard{
      display:grid;
      grid-template-columns:70px minmax(0, 1fr);
      gap:18px;
      align-items:center;
      min-height:150px;
      padding:24px;
      border-left:1px solid var(--source-line);
    }

    .frictionCard:first-child{
      border-left:0;
    }

    .frictionCard .iconBox{
      width:70px;
      height:70px;
      border-radius:999px;
      color:var(--source-blue);
      background:#eef5ff;
    }

    .frictionCard h3,
    .advantageCard h3,
    .gainCard h3,
    .stepItem h3,
    .pathItem h3{
      margin:0 0 8px;
      color:var(--source-ink);
      font-size:17px;
      line-height:1.3;
      letter-spacing:0;
    }

    .frictionCard p,
    .gainCard p,
    .stepItem p,
    .pathItem p{
      margin:0;
      color:var(--source-muted);
      font-size:13px;
      line-height:1.62;
    }

    .advantageGrid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:20px;
    }

    .advantageCard{
      position:relative;
      overflow:hidden;
      min-height:310px;
      padding:28px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.10);
      background:#071f43;
      box-shadow:0 18px 42px rgba(17,31,67,.14);
      color:#fff;
      isolation:isolate;
    }

    .advantageCard::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-2;
      background:var(--card-bg) center/cover no-repeat;
      transform:scale(1.02);
      filter:saturate(.98) contrast(1.03) brightness(.82);
    }

    .advantageCard::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:-1;
      background:
        linear-gradient(90deg, rgba(7,31,67,.96), rgba(7,31,67,.70) 55%, rgba(7,31,67,.36)),
        linear-gradient(180deg, rgba(7,31,67,.12), rgba(7,31,67,.82));
    }

    .advantageCard h3{
      max-width:420px;
      color:#fff;
      font-size:23px;
    }

    .checkList,
    .compareList{
      display:grid;
      gap:12px;
      margin:20px 0 0;
      padding:0;
      list-style:none;
    }

    .checkList li,
    .compareList li{
      display:flex;
      gap:10px;
      align-items:flex-start;
      color:rgba(234,240,255,.86);
      line-height:1.55;
      font-size:14px;
    }

    .checkDot,
    .badDot{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:18px;
      height:18px;
      margin-top:2px;
      border-radius:999px;
      flex:0 0 auto;
      font-size:12px;
      font-weight:950;
    }

    .checkDot{
      color:#fff;
      background:#0f9f67;
    }

    .badDot{
      color:#fff;
      background:var(--source-danger);
    }

    .benchmarkGrid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:14px;
    }

    .metricCard,
    .gainCard,
    .messagePanel,
    .faqItem{
      border:1px solid var(--source-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .metricCard{
      display:grid;
      grid-template-columns:54px minmax(0, 1fr);
      gap:14px;
      padding:20px;
      align-items:start;
    }

    .metricIcon{
      width:54px;
      height:54px;
      color:var(--source-green);
      background:#effff7;
      border-color:rgba(15,159,103,.20);
    }

    .metricCard b{
      display:block;
      margin:0 0 8px;
      color:var(--source-ink);
      font-size:25px;
      letter-spacing:0;
    }

    .metricCard strong{
      display:block;
      color:var(--source-ink);
      font-size:14px;
      line-height:1.25;
    }

    .metricCard p{
      margin:8px 0 0;
      color:var(--source-muted);
      font-size:12px;
      line-height:1.55;
    }

    .modelNote{
      max-width:920px;
      margin:16px auto 0;
      color:var(--source-muted);
      font-size:13px;
      line-height:1.62;
      text-align:center;
    }

    .compareSection{
      display:grid;
      grid-template-columns:minmax(0, 1fr) 74px minmax(0, 1fr);
      gap:0;
      align-items:start;
    }

    .compareCard{
      padding:24px 28px 26px;
      border:1px solid var(--source-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .compareCard.bad{
      border-color:rgba(199,71,71,.25);
      background:linear-gradient(135deg, #fff 0%, #fff7f7 100%);
    }

    .compareCard.good{
      border-color:rgba(15,159,103,.25);
      background:linear-gradient(135deg, #fff 0%, #f1fff8 100%);
    }

    .compareCard h3{
      margin:0 0 16px;
      color:var(--source-ink);
      font-size:22px;
      letter-spacing:0;
    }

    .compareCard.bad h3{
      color:#aa2d2d;
    }

    .compareCard.good h3{
      color:#08784d;
    }

    .compareList li{
      color:var(--source-text);
    }

    .vsBubble{
      align-self:center;
      justify-self:center;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:54px;
      height:54px;
      border-radius:999px;
      background:#071f43;
      color:#fff;
      font-size:16px;
      font-weight:950;
      box-shadow:0 16px 34px rgba(7,31,67,.18);
      z-index:2;
    }

    .gainGrid{
      display:grid;
      grid-template-columns:repeat(6, minmax(0, 1fr));
      gap:12px;
    }

    .gainCard{
      min-height:190px;
      padding:20px 16px;
      text-align:center;
    }

    .gainIcon{
      width:50px;
      height:50px;
      margin:0 auto 14px;
      color:var(--source-blue);
      background:#f7fbff;
    }

    .mixedGrid{
      display:grid;
      grid-template-columns:minmax(300px, .78fr) minmax(0, 1fr);
      gap:24px;
      align-items:stretch;
    }

    .mixedImage{
      overflow:hidden;
      min-height:430px;
      border:1px solid var(--source-line);
      border-radius:8px;
      background:
        linear-gradient(180deg, rgba(3,18,42,.02), rgba(3,18,42,.1)),
        url("/images/insights/insights-problem-mixed-specifications.webp") center/cover no-repeat;
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .stepList{
      display:grid;
      gap:12px;
    }

    .stepItem{
      display:grid;
      grid-template-columns:44px minmax(0, 1fr);
      gap:14px;
      padding:18px;
      border:1px solid var(--source-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 10px 26px rgba(17,31,67,.05);
    }

    .stepNo{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:44px;
      height:44px;
      border-radius:999px;
      background:#0f9f67;
      color:#fff;
      font-size:13px;
      font-weight:950;
    }

    .pathPanel{
      padding:24px;
      border:1px solid var(--source-line);
      border-radius:8px;
      background:linear-gradient(180deg, #fff 0%, #edf4ff 100%);
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .pathGrid{
      display:grid;
      grid-template-columns:repeat(5, minmax(0, 1fr));
      gap:14px;
    }

    .pathItem{
      position:relative;
      padding-top:58px;
      min-width:0;
    }

    .pathItem::after{
      content:"";
      position:absolute;
      top:24px;
      left:58px;
      right:-14px;
      height:1px;
      border-top:1px dashed rgba(35,101,255,.38);
    }

    .pathItem:last-child::after{
      display:none;
    }

    .pathIcon{
      position:absolute;
      top:0;
      left:0;
      width:48px;
      height:48px;
      color:var(--source-blue);
      background:#fff;
      box-shadow:0 10px 24px rgba(17,31,67,.08);
    }

    .faqGrid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:12px;
    }

    details.faqItem{
      overflow:hidden;
    }

    summary{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      min-height:56px;
      padding:0 18px;
      color:var(--source-ink);
      cursor:pointer;
      font-weight:900;
      list-style:none;
    }

    summary::-webkit-details-marker{
      display:none;
    }

    summary::after{
      content:"+";
      color:var(--source-blue);
      font-size:18px;
      font-weight:900;
    }

    details[open] summary::after{
      content:"-";
    }

    details p{
      margin:0;
      padding:0 18px 18px;
      color:var(--source-muted);
      line-height:1.65;
    }

    .finalCta{
      margin:8px 0 0;
      padding:28px;
      border-radius:8px;
      background:
        linear-gradient(90deg, rgba(7,31,67,.96), rgba(7,31,67,.82)),
        url("/images/container-stacking-yard-sunset.webp") center/cover no-repeat;
      color:#fff;
      box-shadow:0 18px 42px rgba(7,31,67,.18);
    }

    .finalInner{
      display:grid;
      grid-template-columns:minmax(0, .9fr) minmax(520px, 1fr);
      gap:28px;
      align-items:center;
    }

    .finalCta h2{
      margin:0 0 10px;
      color:#fff;
      font-size:30px;
      letter-spacing:0;
    }

    .finalCta p{
      margin:0;
      max-width:720px;
      color:rgba(234,240,255,.78);
      line-height:1.65;
    }

    .ctaFlow{
      display:grid;
      grid-template-columns:repeat(5, minmax(0, 1fr));
      gap:8px;
    }

    .ctaStep{
      position:relative;
      display:grid;
      justify-items:center;
      gap:9px;
      color:rgba(234,240,255,.84);
      font-size:12px;
      font-weight:850;
      text-align:center;
    }

    .ctaStep::after{
      content:"";
      position:absolute;
      top:18px;
      left:calc(50% + 25px);
      width:calc(100% - 42px);
      height:1px;
      background:rgba(82,211,143,.48);
    }

    .ctaStep:last-child::after{
      display:none;
    }

    .ctaDot{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:36px;
      height:36px;
      border-radius:999px;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.20);
      color:#fff;
      font-size:12px;
      font-weight:950;
    }

    :global(.sourcingHero svg *),
    :global(.pageBody svg *){
      fill:none;
      stroke:currentColor;
      stroke-width:1.75;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    @media (max-width:1180px){
      .frictionGrid,
      .advantageGrid,
      .mixedGrid,
      .finalInner{
        grid-template-columns:1fr;
      }

      .frictionCard{
        border-left:0;
        border-top:1px solid var(--source-line);
      }

      .frictionCard:first-child{
        border-top:0;
      }

      .benchmarkGrid,
      .gainGrid{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .pathGrid{
        grid-template-columns:repeat(3, minmax(0, 1fr));
      }

      .pathItem::after{
        display:none;
      }
    }

    @media (max-width:900px){
      .heroInner,
      .compareSection{
        grid-template-columns:1fr;
      }

      .heroInner{
        min-height:auto;
        padding:48px 0 34px;
      }

      .vsBubble{
        margin:14px 0;
      }

      .pathGrid,
      .ctaFlow{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .ctaStep::after{
        display:none;
      }
    }

    @media (max-width:680px){
      .heroCopy h1{
        font-size:35px;
      }

      .heroCopy p{
        font-size:16px;
      }

      .sectionBlock{
        padding:24px 0;
      }

      .sectionHeader{
        text-align:left;
      }

      .sectionHeader h2{
        font-size:26px;
      }

      .frictionCard{
        grid-template-columns:1fr;
      }

      .benchmarkGrid,
      .gainGrid,
      .pathGrid,
      .faqGrid,
      .ctaFlow{
        grid-template-columns:1fr;
      }

      .mixedImage{
        min-height:280px;
      }

      .finalCta{
        padding:22px;
      }
    }
  </style>

  <header class="sourcingHero">
    <div class="container wide heroInner">
      <div class="heroCopy">
        <p class="eyebrow">CertiSpares / Sourcing Strategy</p>
        <h1>Multi-Supplier Truck Parts Sourcing Built Around <span>Cost and Turnover</span></h1>
        <p>
          Many truck parts buyers do not need one full container of one product line. We help organize mixed RFQs,
          compare suppliers on the same basis, consolidate quotations, and plan a more practical shipment structure.
        </p>
        <div class="heroActions">
          <a class="actionBtn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <span set:html={icons.whatsapp}></span>
            Start Sourcing Conversation
          </a>
          <a class="actionBtn secondary" href="/cases">View Cases <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class="controlPanel" aria-label="Sourcing control logic">
        <h2>Sourcing Control Logic</h2>
        <div class="controlList">
          {controlItems.map((item) => (
            <div class="controlItem">
              <span class="iconBox" aria-hidden="true" set:html={icons[item.icon]}></span>
              <span>
                <strong>{item.title}</strong>
                {item.text}
              </span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </header>

  <main class="pageBody">
    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>Why Traditional One-Supplier Buying Creates Friction</h2>
      </div>
      <div class="frictionGrid">
        {frictionCards.map((card) => (
          <article class="frictionCard">
            <span class="iconBox" aria-hidden="true" set:html={icons[card.icon]}></span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>The Two <span>Strategic Advantages</span></h2>
      </div>
      <div class="advantageGrid">
        {advantageCards.map((card) => (
          <article class="advantageCard" style={`--card-bg:url('${card.image}')`}>
            <h3>{card.title}</h3>
            <ul class="checkList">
              {card.bullets.map((bullet) => (
                <li><span class="checkDot">✓</span><span>{bullet}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>Benchmark Snapshot <span>(Illustrative Model)</span></h2>
      </div>
      <div class="benchmarkGrid">
        {benchmarkCards.map((card) => (
          <article class="metricCard">
            <span class="metricIcon" aria-hidden="true" set:html={icons[card.icon]}></span>
            <div>
              <b>{card.metric}</b>
              <strong>{card.title}</strong>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="modelNote">
        These are benchmark and illustrative models. Actual results depend on SKU mix, supplier options,
        freight lane, quantities, packing, and local market demand.
      </p>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>Single-Line Buying vs. <span>Balanced Container Logic</span></h2>
      </div>
      <div class="compareSection">
        <article class="compareCard bad">
          <h3>Single-Line Buying</h3>
          <ul class="compareList">
            {singleLineBullets.map((bullet) => (
              <li><span class="badDot">×</span><span>{bullet}</span></li>
            ))}
          </ul>
        </article>
        <span class="vsBubble">VS</span>
        <article class="compareCard good">
          <h3>Balanced Multi-SKU Sourcing</h3>
          <ul class="compareList">
            {balancedBullets.map((bullet) => (
              <li><span class="checkDot">✓</span><span>{bullet}</span></li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>What Buyers Gain With the <span>Same Budget</span></h2>
      </div>
      <div class="gainGrid">
        {gainCards.map((card) => (
          <article class="gainCard">
            <span class="gainIcon" aria-hidden="true" set:html={icons[card.icon]}></span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="mixedGrid">
        <div>
          <div class="sectionHeader left">
            <h2>How We Turn a Mixed Parts List Into a Workable Sourcing Plan</h2>
            <p>
              Buyers often send Excel sheets, screenshots, supplier codes, photos, OE numbers, and sales notes.
              The first job is to turn that input into a sourcing structure suppliers and buyers can both understand.
            </p>
          </div>
          <div
            class="mixedImage"
            role="img"
            aria-label="Mixed truck parts RFQ list with sourcing notes"
            style="background-image:linear-gradient(180deg, rgba(3,18,42,.02), rgba(3,18,42,.1)), url('/images/insights/insights-problem-mixed-specifications.webp');"
          >
          </div>
        </div>

        <div class="stepList">
          {mixedListSteps.map((step) => (
            <article class="stepItem">
              <span class="stepNo">{step.n}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>The Practical <span>Sourcing Path</span></h2>
        <p>For the full RFQ-to-shipment workflow, buyers can continue to the How It Works page.</p>
      </div>
      <div class="pathPanel">
        <div class="pathGrid">
          {sourcingPath.map((item) => (
            <article class="pathItem">
              <span class="pathIcon" aria-hidden="true" set:html={icons[item.icon]}></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="faqGrid">
        {faq.map((item) => (
          <details class="faqItem">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="finalCta">
        <div class="finalInner">
          <div>
            <h2>Have a mixed parts list or container plan to <span>discuss?</span></h2>
            <p>
              Send what you already have: photos, Excel lists, supplier quotes, OE numbers, quantities, and destination.
              We can review the sourcing structure first and clarify the next workable step through conversation.
            </p>
            <div class="heroActions">
              <a class="actionBtn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                <span set:html={icons.whatsapp}></span>
                Chat on WhatsApp
              </a>
              <a class="actionBtn secondary" href={emailUrl}>
                <span set:html={icons.mail}></span>
                Send by Email
              </a>
            </div>
          </div>
          <div class="ctaFlow" aria-label="Mixed sourcing conversation path">
            {ctaFlow.map((item, index) => (
              <div class="ctaStep">
                <span class="ctaDot">{String(index + 1).padStart(2, "0")}</span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
