const whatsappUrl = `https://wa.me/${WHATSAPP_E164}?text=${encodeURIComponent(whatsappStarter)}`;
const emailUrl = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Mixed truck parts sourcing inquiry")}&body=${encodeURIComponent(whatsappStarter)}`;

const controlItems = [
