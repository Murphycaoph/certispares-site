const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Multi-Supplier Truck Parts Sourcing Built Around Cost and Turnover",
    description:
      "Sourcing strategy page for commercial vehicle parts buyers, covering multi-supplier consolidation, balanced SKU sourcing, quotation alignment, benchmark models, and shipment planning.",
    url: "https://certispares.com/sourcing/",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://certispares.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
