---
import BaseLayout from "../layouts/BaseLayout.astro";

// Contacts
const CONTACT_EMAIL = "murphy@certispares.com";
const LOCATION = "Beijing / Hebei, China";

// WhatsApp / Facebook
const WHATSAPP_E164 = "8615633022618"; // digits only: country code + number
const WHATSAPP_DISPLAY = "+86 156 3302 2618";
const WHATSAPP_STARTER =
  "Hello CertiSpares, I have a truck parts RFQ. Brand/model: __. OE/part no: __. Qty: __. Destination: __. Photos available: yes/no.";
const WHATSAPP_URL =
  `https://wa.me/${WHATSAPP_E164}?text=${encodeURIComponent(WHATSAPP_STARTER)}`;

// Facebook profile/page URL (public)
const FACEBOOK_URL = "https://www.facebook.com/profile.php?id=61585722976089";

const minimumInputs = [
  "OE or part number if available",
  "VIN, vehicle model, or engine/axle application",
  "Photos, old samples, drawings, or dimensions",
  "Quantity, destination country or port, and preferred Incoterms",
  "Packaging, labeling, carton mark, or private label notes",
];

const rfqTypeGuides = [
  {
    title: "OE-number RFQ",
    text: "Send OE or part numbers, quantity, destination, and any preferred brand or quality level.",
  },
  {
    title: "Photo-only RFQ",
    text: "Send clear photos from several angles, dimensions, visible marks, vehicle model, and installation position.",
  },
  {
    title: "Mixed-SKU sheet",
    text: "Send the spreadsheet, old supplier sheet, destination, target quantities, and notes for urgent or unclear lines.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Send an RFQ or Business Inquiry",
    description:
      "Contact CertiSpares with an RFQ or business inquiry using OE numbers, vehicle model, quantity, destination, and related files.",
    url: "https://certispares.com/contact/",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "CertiSpares",
    url: "https://certispares.com/",
    email: CONTACT_EMAIL,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Beijing / Hebei",
      addressCountry: "CN",
    },
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "sales",
        email: CONTACT_EMAIL,
        telephone: "+86 156 3302 2618",
        availableLanguage: ["en"],
      },
    ],
    sameAs: [FACEBOOK_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://certispares.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Contact",
        item: "https://certispares.com/contact/",
      },
    ],
  },
];
---

<BaseLayout
  title="Send a Structured Truck Parts RFQ | CertiSpares"
  description="Send a structured truck parts RFQ with OE numbers, VIN or vehicle model, photos, quantities, destination, Incoterms, packaging notes, and files."
  keywords={["send RFQ truck parts", "commercial vehicle parts inquiry", "OEM truck parts RFQ", "heavy duty truck parts RFQ", "business inquiry China sourcing"]}
  canonical="/contact/"
  ogImage="/images/china-industrial-warehouse.webp"
  jsonLd={jsonLd}
>
  <style>
    :root{
      --bg:#eef3f7;
      --text:#1d2a36;
      --muted:#5f6d86;
      --line:rgba(29,42,54,.10);
      --brand:#3957E9;
      --brand2:#3957E9;
    }

    :global(main){
      background:linear-gradient(180deg, #f5f8fc 0%, #eef3f7 100%);
    }

  .pageHero{
      position:relative;
      padding:46px 0 20px;
      border-bottom:1px solid var(--line);
      overflow:hidden;
      isolation:isolate;
      background:
        linear-gradient(180deg, rgba(11,16,32,.34) 0%, rgba(11,16,32,.82) 72%, rgba(11,16,32,1) 100%),
        radial-gradient(900px 420px at 25% 20%, rgba(57,87,233,.22), transparent 60%),
        #0b1020;
    }

  .kicker{
      letter-spacing:.12em;
      text-transform:uppercase;
      font-size:.8rem;
      opacity:.82;
      margin:0 0 .75rem;
      color:rgba(255,255,255,.82);
    }

  .title{
      margin:0 0 .8rem;
      font-size:40px;
      letter-spacing:-.4px;
      line-height:1.12;
      color:#fff;
    }

  .sub{
      margin:0;
      max-width:78ch;
      color:rgba(225,233,255,.86);
      line-height:1.75;
    }

  .contentWrap{
      width:min(var(--container-default), calc(100% - 64px));
      margin: 0 auto;
    }

  .grid{
      display:grid;
      grid-template-columns: .9fr 1.1fr;
      gap:16px;
      align-items:start;
    }

  .card{
      padding:18px;
      border-radius:var(--radius-card);
      background:#fff;
      border:1px solid rgba(29,42,54,.10);
      box-shadow:0 14px 32px rgba(24,39,56,.05);
    }

  .card h2{ margin:0 0 10px; font-size:18px; letter-spacing:-.2px; color:#1d2a36; }

  .muted{ color:var(--muted); }

  .infoList{ display:grid; gap:12px; margin-top:14px; }

  .infoItem{
      padding:14px;
      border-radius:16px;
      background:#fff;
      border:1px solid rgba(29,42,54,.10);
    }

  .infoItem b{ display:block; margin-bottom:6px; color:#1d2a36; }

    form{ display:grid; gap:12px; }

  .row2{ display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
    label{ display:grid; gap:8px; font-weight:850; color:#1d2a36; }

    input, textarea, select{
      width:100%;
      border-radius:14px;
      border:1px solid rgba(29,42,54,.12);
      background:#fff;
      color:var(--text);
      padding:12px 12px;
      outline:none;
      font: inherit;
      box-sizing: border-box;
      min-width: 0;
    }

    input:focus, textarea:focus, select:focus{
      border-color:rgba(57,87,233,.45);
      box-shadow:0 0 0 4px rgba(57,87,233,.10);
    }

  .row2 > label{ min-width: 0; }

    textarea{
      min-height:120px;
      resize:vertical;
    }

    input::placeholder,
    textarea::placeholder{
      color: rgba(95,109,134,.72);
    }

  .hint{
      font-size:12px;
      color:var(--muted);
      line-height:1.5;
      margin-top:-6px;
    }

  .btnRow{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:6px;
    }

  .note{
      margin-top:12px;
      padding:14px;
      border-radius:16px;
      background:linear-gradient(135deg, rgba(57,87,233,.10), rgba(255,255,255,.92));
      border:1px solid rgba(57,87,233,.16);
      color:var(--muted);
      line-height:1.7;
      box-shadow:0 16px 40px rgba(24,39,56,.05);
    }

  .note b{ color:#1d2a36; }

  .checkList{
      margin:10px 0 0;
      padding-left:18px;
      display:grid;
      gap:6px;
    }

  .checkList li{
      color:var(--muted);
      line-height:1.55;
    }

  .sampleBox{
      margin-top:12px;
      padding:14px;
      border-radius:16px;
      background:#fff;
      border:1px solid rgba(29,42,54,.10);
      color:var(--muted);
      line-height:1.7;
      box-shadow:0 14px 32px rgba(24,39,56,.05);
    }

  .sampleBox b{
      display:block;
      margin-bottom:6px;
      color:#1d2a36;
    }

  .sampleBox p{
      margin:0;
      font-size:13px;
      line-height:1.65;
    }

  .guideGrid{
      margin-top:12px;
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:10px;
    }

  .guideCard{
      padding:12px;
      border-radius:16px;
      background:#fff;
      border:1px solid rgba(29,42,54,.10);
      box-shadow:0 10px 24px rgba(24,39,56,.04);
    }

  .guideCard b{
      display:block;
      margin-bottom:6px;
      color:#1d2a36;
      font-size:13px;
    }

  .guideCard p{
      margin:0;
      color:var(--muted);
      font-size:12px;
      line-height:1.55;
    }

  .linkPill{
      display:inline-flex;
      gap:8px;
      align-items:center;
      padding:8px 12px;
      border-radius:999px;
      border:1px solid rgba(29,42,54,.10);
      background:#fff;
      color:#1d2a36;
      text-decoration:none;
    }

  .btnRow .btn.primary{
      color:#fff;
      background:#3957E9;
    }

  .btnRow .btn:not(.primary){
      color:#fff;
      background:#3957E9;
      border-color:#3957E9;
    }@media (max-width: 980px){
      .grid{ grid-template-columns:1fr; }

  .row2{ grid-template-columns:1fr; }

  .guideGrid{ grid-template-columns:1fr; }
    }
  </style>

  <header class="pageHero">
    <div class="contentWrap">
      <p class="kicker">CertiSpares / Contact</p>

      <h1 class="title">Send a Structured Truck Parts RFQ</h1>

      <p class="sub">
        Send your RFQ with OE or part numbers, VIN or vehicle model, photos, quantity, destination, and packing notes.
        We usually reply within 24-48 hours with follow-up questions or the next workable sourcing step.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="contentWrap">
      <div class="grid">
        <!-- Left: contact info -->
        <div class="card">
          <h2>How to Contact Effectively</h2>
          <p class="muted" style="line-height:1.7;">
            For the fastest handling, send the key RFQ details first: OE number, VIN or vehicle model, quantity,
            destination, and photos. We usually respond within 24-48 hours. For urgent clarification, WhatsApp is faster than email.
          </p>
          <p class="muted" style="line-height:1.7;">
            If you want to understand the workflow before sending an inquiry, review <a href="/how-it-works">how the process works</a>. If you are still comparing service scope, see our <a href="/sourcing">truck parts sourcing service</a> and <a href="/capabilities">quality control and sourcing support</a>.
          </p>

          <div class="infoList">
            <div class="infoItem">
              <b>Email</b>
              <div class="muted">
                <a class="linkPill" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
                <div style="margin-top:8px;">Best for RFQ files, part lists, and detailed business inquiries.</div>
              </div>
            </div>

            <div class="infoItem">
              <b>WhatsApp</b>
              <div class="muted">
                <a class="linkPill" href={WHATSAPP_URL} target="_blank" rel="noopener">
                  Chat on WhatsApp ({WHATSAPP_DISPLAY})
                </a>
                <div style="margin-top:8px;">Best for faster follow-up, photos, quick clarification, and urgent RFQs.</div>
              </div>
            </div>

            <div class="infoItem">
              <b>Facebook</b>
              <div class="muted">
                <a class="linkPill" href={FACEBOOK_URL} target="_blank" rel="noopener">
                  Visit our Facebook
                </a>
              </div>
            </div>

            <div class="infoItem">
              <b>Location</b>
              <div class="muted">{LOCATION}</div>
            </div>
          </div>

          <div class="note">
            <b>Minimum useful RFQ:</b>
            <ul class="checkList">
              {minimumInputs.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="sampleBox">
            <b>WhatsApp starter</b>
            <p>{WHATSAPP_STARTER}</p>
          </div>

          <div class="sampleBox">
            <b>Which kind of RFQ are you sending?</b>
            <div class="guideGrid">
              {rfqTypeGuides.map((item) => (
                <div class="guideCard">
                  <b>{item.title}</b>
                  <p>{item.text}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: RFQ form (Netlify Forms) -->
        <div class="card">
          <h2>RFQ Submission Form</h2>
          <p class="muted" style="margin-bottom:14px; line-height:1.7;">
            Submit the form here if you want us to review the RFQ directly. The clearer the inputs, the easier it is to compare suppliers on the same scope.
          </p>
          <p class="muted" style="margin-bottom:14px; line-height:1.7;">
            If you are still validating suppliers or quotations before submitting, start with <a href="/blog/how-to-identify-reliable-auto-parts-suppliers-in-china">our supplier screening guide</a> and <a href="/blog/how-to-compare-auto-parts-quotations-from-chinese-suppliers">quotation comparison guide</a>.
          </p>

          <form
            name="rfq"
            method="POST"
            action="/thank-you"
            data-netlify="true"
            netlify-honeypot="bot-field"
            enctype="multipart/form-data"
          >
            <!-- Required by Netlify -->
            <input type="hidden" name="form-name" value="rfq" />

            <!-- 闁?Force redirect after successful submission (most reliable) -->
            <input type="hidden" name="redirect" value="https://certispares.com/thank-you/" />

            <!-- Honeypot field (hidden from humans, visible to bots) -->
            <p style="display:none">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>

            <div class="row2">
              <label>
                Name
                <input name="name" placeholder="Your name" required />
              </label>
              <label>
                Company
                <input name="company" placeholder="Company name" />
              </label>
            </div>

            <div class="row2">
              <label>
                Email
                <input name="email" type="email" placeholder="you@company.com" required />
              </label>
              <label>
                WhatsApp / phone
                <input name="whatsapp" placeholder="+ country code and number" />
              </label>
            </div>

            <div class="row2">
              <label>
                Preferred contact
                <select name="preferredContact">
                  <option value="Email">Email</option>
                  <option value="WhatsApp">WhatsApp</option>
                  <option value="Either">Either</option>
                </select>
              </label>
              <label>
                Destination
                <input name="destination" placeholder="Country / Port (e.g., Mombasa)" />
              </label>
            </div>

            <div class="row2">
              <label>
                OE / part number references
                <input name="oeRefs" placeholder="OE, part no., casting mark, supplier code" />
              </label>
              <label>
                VIN / vehicle model / application
                <input name="vehicleRef" placeholder="VIN, truck model, engine model, axle application" />
              </label>
            </div>

            <div class="row2">
              <label>
                Parts info type
                <select name="infoType">
                  <option value="OEM/Part Numbers">OEM/Part Numbers</option>
                  <option value="Photos Only">Photos Only</option>
                  <option value="Mixed">Mixed</option>
                  <option value="Old Supplier Sheet">Old Supplier Sheet</option>
                </select>
              </label>
              <label>
                Target quantity
                <input name="qty" placeholder="e.g., 500 pcs / 1 pallet / 1 mixed container" />
              </label>
            </div>

            <div class="row2">
              <label>
                Preferred Incoterms
                <select name="incoterms">
                  <option value="">Not sure yet</option>
                  <option value="EXW">EXW</option>
                  <option value="FOB">FOB</option>
                  <option value="CIF">CIF</option>
                  <option value="DAP/DDP discussion">DAP / DDP discussion</option>
                </select>
              </label>
              <label>
                Target market / old supplier reference
                <input name="referenceMarket" placeholder="e.g., Kenya market / old supplier code / competitor reference" />
              </label>
            </div>

            <label>
              Parts list and matching notes
              <textarea
                name="parts"
                placeholder="Example: Brake chamber 3519..., 200 pcs, for HOWO A7. Photos attached. Need neutral packing and FOB Tianjin quotation."
              ></textarea>
            </label>

            <label>
              Attach files (optional)
              <input
                type="file"
                name="files"
                multiple
                accept=".xlsx,.xls,.pdf,.png,.jpg,.jpeg"
              />
            </label>
            <div class="hint">
              Supported formats: Excel, PDF, PNG, JPG. Multiple files allowed.
            </div>

            <label>
              Packaging / labeling requirements (optional)
              <textarea name="pack" placeholder="Carton marks, private label, barcode, pallet type, etc."></textarea>
            </label>

            <label>
              Notes (optional)
              <textarea name="notes" placeholder="Target price level, lead time expectations, competitor references, etc."></textarea>
            </label>

            <div class="btnRow">
              <button class="btn primary" type="submit">Submit RFQ</button>
              <a class="btn" href="/how-it-works">See Workflow</a>
              <a class="btn" href="/capabilities">View Capabilities</a>
            </div>

            <div class="note">
              <b>Minimum needed:</b> OE or part numbers if available, VIN or vehicle model, photos or dimensions, quantity, destination port or country.
              <br />
              <b>Helpful extras:</b> full part list, packaging requirements, Incoterms, target lead time, and any old supplier reference data.
            </div>
          </form>

          <!-- Optional: light click tracking for WhatsApp / Facebook -->
          <script>
            (function(){
              // Outbound click tracking (WhatsApp / Facebook)
              document.addEventListener("click", (e) => {
                const a = e.target?.closest?.("a");
                if (!a) return;

                const href = a.getAttribute("href") || "";
                const isWhatsApp = href.includes("wa.me") || href.includes("whatsapp");
                const isFacebook = href.includes("facebook.com");

                try {
                  if (typeof gtag === "function" && (isWhatsApp || isFacebook)) {
                    gtag("event", "outbound_click", {
                      event_category: "engagement",
                      link_url: href,
                      link_type: isWhatsApp ? "whatsapp" : "facebook",
                      page_location: window.location.href,
                    });
                  }
                } catch (err) {}
              });
            })();
          </script>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
