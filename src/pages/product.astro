  arrow: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>`,
  whatsapp: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 19 6 15.8A7.5 7.5 0 1 1 9 18.6z"/><path d="M9.3 8.7c.2 2.7 2.3 4.9 5 5.5l1.2-1.2"/></svg>`,
