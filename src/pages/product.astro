  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Start Your Truck Parts RFQ",
    description:
      "Start a truck parts RFQ from brand, part system, or mixed parts list. CertiSpares reviews matching scope before quotation and supplier comparison.",
    url: "https://certispares.com/product/",
  },
  {
