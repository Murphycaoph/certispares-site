---

<BaseLayout
  title="Truck Parts RFQ Support for China Sourcing | CertiSpares"
  description="Send OE numbers, photos, VIN/model details, part lists, quantities, and destination information for structured truck parts sourcing support from China."
  keywords={["truck parts RFQ", "truck parts by brand", "truck parts by system", "mixed SKU RFQ", "commercial vehicle parts sourcing"]}
  canonical="/product/"
  ogImage="/images/freight-truck-highway-sunset.webp"
  jsonLd={jsonLd}
>
  <style>
    :root{
      --ink:#071a36;
      --text:#10233d;
      --muted:#5a6b84;
      --line:rgba(16,35,61,.12);
      --blue:#0f63ff;
      --blue2:#2f7dff;
      --soft:#eef5ff;
      --wash:#f4f8fd;
    }

    :global(main){
      background:
        radial-gradient(900px 460px at 8% 42%, rgba(47,125,255,.10), transparent 66%),
        linear-gradient(180deg, #f6f9fd 0%, #edf4fb 100%);
    }

    .icon{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      line-height:0;
    }

    .icon :global(svg){
      width:1em;
      height:1em;
      display:block;
    }

    .icon :global(path),
    .icon :global(circle){
      fill:none;
      stroke:currentColor;
      stroke-width:2;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .productHero{
      position:relative;
      overflow:hidden;
      isolation:isolate;
      min-height:438px;
      background:#061427;
      color:#fff;
    }

    .productHero::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-2;
      background:url("/images/homepage/homepage-hero-truck.webp") center/cover no-repeat;
      filter:saturate(1.04) contrast(1.04) brightness(.70);
      transform:scale(1.03);
    }

    .productHero::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:-1;
      background:
        linear-gradient(90deg, rgba(5,16,34,.96) 0%, rgba(5,16,34,.82) 45%, rgba(5,16,34,.58) 100%),
        radial-gradient(760px 360px at 24% 24%, rgba(15,99,255,.30), transparent 64%);
    }

    .heroInner{
      display:grid;
      grid-template-columns:minmax(0, 1.02fr) minmax(330px, .72fr);
      gap:48px;
      align-items:center;
      padding:58px 0 54px;
    }

    .eyebrow{
      margin:0 0 14px;
      color:#3c82ff;
      font-size:13px;
      font-weight:950;
      line-height:1.2;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .heroTitle{
      max-width:740px;
      margin:0;
      color:#fff;
      font-size:58px;
      line-height:1.04;
      letter-spacing:0;
    }

    .heroTitle span{
      color:#3c82ff;
    }

    .heroLead{
      max-width:760px;
      margin:22px 0 0;
      color:rgba(239,246,255,.90);
      font-size:17px;
      line-height:1.72;
    }

    .heroActions,
    .ctaActions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:28px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      min-height:46px;
      padding:0 22px;
      border-radius:6px;
      border:1px solid rgba(255,255,255,.32);
      color:#fff;
      font-weight:900;
      text-decoration:none;
      transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease, background .22s ease;
    }

    .btn:hover{
      transform:translateY(-2px);
      box-shadow:0 16px 34px rgba(7,18,38,.18);
    }

    .btn.primary{
      background:var(--blue);
      border-color:var(--blue);
      box-shadow:0 16px 34px rgba(15,99,255,.26);
    }

    .btn.light{
      color:var(--blue);
      background:#fff;
      border-color:#fff;
    }

    .heroActions .btn:not(.primary),
    .ctaActions .btn:not(.primary){
      color:#fff;
      background:rgba(255,255,255,.08);
      border-color:rgba(255,255,255,.32);
      backdrop-filter:blur(8px);
    }

    .heroActions .btn:not(.primary):hover,
    .ctaActions .btn:not(.primary):hover{
      background:rgba(255,255,255,.14);
      border-color:rgba(255,255,255,.44);
    }

    .routerPanel{
      position:relative;
      padding:28px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.16);
      background:linear-gradient(180deg, rgba(8,30,64,.84), rgba(6,18,38,.78));
      box-shadow:0 24px 70px rgba(0,0,0,.34);
      backdrop-filter:blur(12px);
      animation:riseIn .72s ease both;
    }

    .routerTitle{
      margin:0 0 20px;
      color:#fff;
      font-size:22px;
      line-height:1.2;
      letter-spacing:0;
    }

    .routerList{
      display:grid;
      gap:18px;
    }

    .routerItem{
      display:grid;
      grid-template-columns:60px 1fr;
      gap:16px;
      align-items:center;
      position:relative;
    }

    .routerItem:not(:last-child)::after{
      content:"";
      position:absolute;
      left:29px;
      top:62px;
      width:1px;
      height:26px;
      background:linear-gradient(180deg, rgba(73,137,255,.9), rgba(73,137,255,.05));
    }

    .routerIcon{
      width:58px;
      height:58px;
      border-radius:50%;
      display:grid;
      place-items:center;
      color:#fff;
      background:linear-gradient(135deg, var(--blue), #2d7cff);
      box-shadow:0 14px 34px rgba(15,99,255,.26);
      font-size:27px;
    }

    .routerCopy strong{
      display:block;
      margin-bottom:5px;
      color:#fff;
      font-size:15px;
      font-weight:950;
    }

    .routerCopy span{
      display:block;
      color:rgba(231,240,255,.78);
      font-size:13px;
      line-height:1.55;
    }

    .section{
      padding:36px 0;
    }

    .section.compact{
      padding-top:18px;
    }

    .section.alt{
      background:linear-gradient(180deg, rgba(231,241,255,.58), rgba(245,249,253,.86));
      border-block:1px solid rgba(16,35,61,.06);
    }

    .sectionHead{
      display:flex;
      justify-content:space-between;
      gap:22px;
      align-items:flex-end;
      margin-bottom:22px;
    }

    .sectionKicker{
      margin:0 0 8px;
      color:var(--blue);
      font-weight:950;
      font-size:13px;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .sectionTitle{
      margin:0;
      color:var(--ink);
      font-size:32px;
      line-height:1.16;
      letter-spacing:0;
    }

    .sectionDesc{
      max-width:820px;
      margin:8px 0 0;
      color:var(--muted);
      line-height:1.72;
    }

    .entryGrid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:22px;
    }

    .entryCard{
      position:relative;
      min-width:0;
      overflow:hidden;
      border-radius:8px;
      background:#fff;
      border:1px solid rgba(16,35,61,.10);
      box-shadow:0 18px 44px rgba(12,33,64,.08);
      transition:transform .24s ease, box-shadow .24s ease, border-color .24s ease;
    }

    .entryCard:hover{
      transform:translateY(-4px);
      box-shadow:0 24px 58px rgba(12,33,64,.13);
      border-color:rgba(15,99,255,.22);
    }

    .entryMedia{
      position:relative;
      aspect-ratio:16 / 8.2;
      overflow:hidden;
      background:#071a36;
    }

    .entryMedia img,
    .systemMedia img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
      transition:transform .34s ease;
    }

    .entryCard:hover .entryMedia img,
    .systemCard:hover .systemMedia img{
      transform:scale(1.06);
    }

    .entryBody{
      padding:22px;
      display:grid;
      gap:12px;
    }

    .entryHead{
      display:flex;
      gap:12px;
      align-items:center;
    }

    .entryNo{
      width:34px;
      height:34px;
      border-radius:8px;
      display:grid;
      place-items:center;
      flex:0 0 34px;
      color:#fff;
      background:var(--blue);
      font-size:13px;
      font-weight:950;
    }

    .entryTitle{
      margin:0;
      color:var(--ink);
      font-size:23px;
      line-height:1.2;
      letter-spacing:0;
    }

    .entryText,
    .systemParts,
    .inputCard p,
    .messyItem p{
      margin:0;
      color:var(--muted);
      line-height:1.66;
    }

    .systemParts{
      text-align:left;
    }

    .tagRow{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    .tag{
      display:inline-flex;
      align-items:center;
      min-height:26px;
      padding:0 9px;
      border-radius:5px;
      color:#0759e8;
      background:#eaf2ff;
      font-size:12px;
      font-weight:900;
    }

    .textLink,
    .reviewLink{
      display:inline-flex;
      align-items:center;
      gap:8px;
      color:#0759e8;
      font-weight:950;
      text-decoration:none;
    }

    .textLink .icon,
    .reviewLink .icon{
      font-size:17px;
      transition:transform .18s ease;
    }

    .textLink:hover .icon,
    .reviewLink:hover .icon{
      transform:translateX(3px);
    }

    .brandArea{
      display:grid;
      grid-template-columns:minmax(0, 1fr) 318px;
      gap:22px;
      align-items:stretch;
    }

    .brandGrid{
      display:grid;
      grid-template-columns:repeat(5, minmax(0, 1fr));
      gap:14px;
    }

    .brandCard{
      min-width:0;
      min-height:176px;
      display:grid;
      grid-template-rows:1fr auto;
      gap:12px;
      padding:12px;
      border-radius:8px;
      background:#fff;
      border:1px solid rgba(16,35,61,.10);
      color:inherit;
      text-decoration:none;
      box-shadow:0 14px 34px rgba(12,33,64,.06);
      transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

    .brandCard:hover{
      transform:translateY(-3px);
      box-shadow:0 20px 44px rgba(12,33,64,.11);
      border-color:rgba(15,99,255,.24);
    }

    .brandLogo{
      min-height:108px;
      display:grid;
      place-items:center;
      overflow:hidden;
      border-radius:6px;
      background:linear-gradient(180deg, #fff 0%, #f7faff 100%);
      border:1px solid rgba(16,35,61,.07);
    }

    .brandLogo img{
      width:100%;
      height:100%;
      object-fit:contain;
      display:block;
      padding:8px;
    }

    .brandMeta{
      display:grid;
      gap:7px;
      text-align:center;
    }

    .brandMeta strong{
      min-height:18px;
      color:var(--ink);
      font-size:13px;
      line-height:1.25;
      font-weight:950;
    }

    .brandMeta span{
      color:#0759e8;
      font-size:12px;
      font-weight:950;
    }

    .brandRfqCard{
      position:relative;
      overflow:hidden;
      min-height:100%;
      padding:26px;
      border-radius:8px;
      background:linear-gradient(145deg, #e8f1ff 0%, #ffffff 58%, #dbeaff 100%);
      border:1px solid rgba(15,99,255,.14);
      box-shadow:0 18px 44px rgba(12,33,64,.08);
      display:grid;
      align-content:center;
      gap:18px;
    }

    .brandRfqIcon{
      width:58px;
      height:58px;
      border-radius:8px;
      display:grid;
      place-items:center;
      color:#0759e8;
      background:#fff;
      border:1px solid rgba(15,99,255,.16);
      box-shadow:0 12px 26px rgba(15,99,255,.10);
      font-size:28px;
    }

    .brandRfqCard h3{
      margin:0;
      color:var(--ink);
      font-size:25px;
      line-height:1.18;
      letter-spacing:0;
    }

    .brandRfqCard p{
      margin:0;
      color:var(--muted);
      line-height:1.68;
    }

    .brandRfqCard .btn{
      color:#fff;
      background:var(--blue);
      border-color:var(--blue);
    }

    .systemGrid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:16px;
    }

    .systemCard{
      min-width:0;
      display:grid;
      grid-template-columns:126px 1fr;
      gap:16px;
      align-items:center;
      padding:14px;
      border-radius:8px;
      background:#fff;
      border:1px solid rgba(16,35,61,.10);
      box-shadow:0 14px 34px rgba(12,33,64,.06);
      color:inherit;
      text-decoration:none;
      text-align:left;
      transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

    .systemCard:hover{
      transform:translateY(-3px);
      box-shadow:0 20px 44px rgba(12,33,64,.11);
      border-color:rgba(15,99,255,.24);
    }

    .systemMedia{
      aspect-ratio:1 / 1;
      overflow:hidden;
      border-radius:6px;
      background:linear-gradient(180deg,#f8fbff,#eef5ff);
    }

    .systemMedia img{
      object-fit:contain;
      padding:12px;
      background:transparent;
    }

    .systemBody{
      min-width:0;
      display:grid;
      gap:7px;
    }

    .systemTitle{
      margin:0;
      color:var(--ink);
      font-size:16px;
      line-height:1.28;
      letter-spacing:0;
      text-align:left;
    }

    .systemInput{
      margin:0;
      color:var(--muted);
      font-size:12px;
      line-height:1.45;
      text-align:left;
    }

    .systemInput strong{
      display:block;
      color:var(--ink);
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.07em;
    }

    .systemCta{
      color:#0759e8;
      font-size:13px;
      font-weight:950;
      text-align:left;
    }

    .inputGrid{
      display:grid;
      grid-template-columns:repeat(6, minmax(0, 1fr));
      gap:16px;
    }

    .inputCard{
      min-width:0;
      padding:22px 18px;
      border-radius:8px;
      background:#fff;
      border:1px solid rgba(16,35,61,.10);
      box-shadow:0 14px 34px rgba(12,33,64,.05);
    }

    .inputIcon,
    .messyIcon{
      width:48px;
      height:48px;
      border-radius:8px;
      display:grid;
      place-items:center;
      margin-bottom:14px;
      color:#0759e8;
      background:#eef5ff;
      border:1px solid rgba(15,99,255,.14);
      font-size:25px;
    }

    .inputCard h3,
    .messyItem h3{
      margin:0 0 8px;
      color:var(--ink);
      font-size:16px;
      line-height:1.28;
      letter-spacing:0;
    }

    .processRail{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:22px;
      align-items:start;
    }

    .processStep{
      position:relative;
      display:grid;
      grid-template-columns:auto 1fr;
      gap:14px;
      min-width:0;
    }

    .processStep:not(:last-child)::after{
      content:"";
      position:absolute;
      top:24px;
      left:calc(100% - 36px);
      width:70px;
      border-top:2px dashed rgba(15,99,255,.36);
    }

    .processNo{
      width:50px;
      height:50px;
      border-radius:50%;
      display:grid;
      place-items:center;
      color:#fff;
      background:var(--blue);
      box-shadow:0 12px 28px rgba(15,99,255,.20);
      font-weight:950;
    }

    .processCopy h3{
      margin:0 0 7px;
      color:var(--ink);
      font-size:16px;
      line-height:1.28;
      letter-spacing:0;
    }

    .processCopy p{
      margin:0;
      color:#0759e8;
      font-size:13px;
      font-weight:950;
      line-height:1.45;
    }

    .messyWrap{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:1px;
      overflow:hidden;
      border-radius:8px;
      background:rgba(16,35,61,.10);
      border:1px solid rgba(16,35,61,.10);
      box-shadow:0 16px 38px rgba(12,33,64,.05);
    }

    .messyItem{
      min-width:0;
      display:grid;
      grid-template-columns:58px 1fr;
      gap:16px;
      padding:24px;
      background:rgba(255,255,255,.78);
    }

    .messyIcon{
      margin:0;
    }

    .productCta{
      position:relative;
      overflow:hidden;
      border-radius:8px;
      background:#061427;
      color:#fff;
      isolation:isolate;
      box-shadow:0 24px 70px rgba(7,18,38,.24);
    }

    .productCta::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-2;
      background:url("/images/homepage/homepage-cta-port.webp") center/cover no-repeat;
      filter:saturate(1.02) contrast(1.04) brightness(.70);
      transform:scale(1.03);
    }

    .productCta::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:-1;
      background:
        linear-gradient(90deg, rgba(6,20,39,.96) 0%, rgba(6,20,39,.86) 46%, rgba(6,20,39,.58) 100%),
        radial-gradient(720px 320px at 18% 18%, rgba(15,99,255,.30), transparent 64%);
    }

    .ctaInner{
      display:grid;
      grid-template-columns:minmax(0, .9fr) minmax(430px, 1.1fr);
      gap:34px;
      align-items:center;
      padding:38px 42px;
    }

    .ctaTitle{
      margin:0;
      color:#fff;
      font-size:33px;
      line-height:1.15;
      letter-spacing:0;
    }

    .ctaText{
      max-width:620px;
      margin:12px 0 0;
      color:rgba(239,246,255,.84);
      line-height:1.7;
    }

    .ctaFlow{
      display:grid;
      grid-template-columns:repeat(5, minmax(0, 1fr));
      gap:14px;
      align-items:start;
    }

    .ctaStep{
      min-width:0;
      display:grid;
      justify-items:center;
      gap:10px;
      text-align:center;
      color:rgba(239,246,255,.9);
      font-size:12px;
      font-weight:900;
      line-height:1.32;
    }

    .ctaIcon{
      width:46px;
      height:46px;
      border-radius:8px;
      display:grid;
      place-items:center;
      color:#d9e8ff;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.22);
      font-size:25px;
    }

    @keyframes riseIn{
      from{ opacity:0; transform:translateY(18px); }
      to{ opacity:1; transform:translateY(0); }
    }

    @media (max-width: 1180px){
      .brandArea{
        grid-template-columns:1fr;
      }

      .systemGrid{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .inputGrid{
        grid-template-columns:repeat(3, minmax(0, 1fr));
      }

      .processStep:not(:last-child)::after{
        display:none;
      }
    }

    @media (max-width: 980px){
      .heroInner,
      .entryGrid,
      .ctaInner{
        grid-template-columns:1fr;
      }

      .heroInner{
        gap:30px;
        padding:50px 0 44px;
      }

      .heroTitle{
        font-size:44px;
      }

      .brandGrid{
        grid-template-columns:repeat(3, minmax(0, 1fr));
      }

      .processRail,
      .messyWrap{
        grid-template-columns:1fr;
      }

      .ctaInner{
        padding:30px 24px;
      }

      .ctaFlow{
        grid-template-columns:repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 680px){
      .productHero{
        min-height:auto;
      }

      .heroTitle{
        font-size:36px;
      }

      .heroLead{
        font-size:15px;
      }

      .heroActions .btn,
      .ctaActions .btn,
      .brandRfqCard .btn{
        flex:1 1 100%;
      }

      .routerPanel{
        padding:22px 18px;
      }

      .routerItem{
        grid-template-columns:52px 1fr;
      }

      .routerIcon{
        width:50px;
        height:50px;
        font-size:23px;
      }

      .section{
        padding:30px 0;
      }

      .sectionTitle{
        font-size:26px;
      }

      .brandGrid,
      .systemGrid,
      .inputGrid,
      .ctaFlow{
        grid-template-columns:1fr;
      }

      .brandCard{
        min-height:160px;
      }

      .messyItem{
        grid-template-columns:1fr;
      }

      .systemCard{
        grid-template-columns:96px 1fr;
        gap:12px;
        align-items:center;
      }

      .systemMedia{
        aspect-ratio:1 / 1;
      }
    }
  </style>

  <header class="productHero">
    <div class="container">
      <div class="heroInner">
        <div>
          <p class="eyebrow">Parts RFQ Entry</p>
          <h1 class="heroTitle">Start Your Truck Parts RFQ <span>From Brand, System, or Parts List</span></h1>
          <p class="heroLead">
            Send the references you already have: truck brand, VIN/model, OE numbers, photos, specs, or a mixed SKU list. We review the matching scope first, then move the RFQ into supplier comparison, quotation, QC, packing, documents, and shipment follow-up.
          </p>
          <div class="heroActions">
            <a class="btn primary" href="#brand-entry">Browse by Brand <span class="icon" set:html={icons.arrow} /></a>
            <a class="btn" href="#part-entry">Browse by Part System <span class="icon" set:html={icons.arrow} /></a>
            <a class="btn" href="/contact"><span class="icon" set:html={icons.whatsapp} /> Send RFQ Directly</a>
          </div>
        </div>

        <aside class="routerPanel" aria-label="RFQ entry router">
          <h2 class="routerTitle">RFQ Entry Router</h2>
          <div class="routerList">
            <div class="routerItem">
              <div class="routerIcon"><span class="icon" set:html={icons.truck} /></div>
              <div class="routerCopy"><strong>Brand-led RFQ</strong><span>When the inquiry starts from truck platform or VIN.</span></div>
            </div>
            <div class="routerItem">
              <div class="routerIcon"><span class="icon" set:html={icons.gear} /></div>
              <div class="routerCopy"><strong>System-led RFQ</strong><span>When the inquiry starts from part system or category.</span></div>
            </div>
            <div class="routerItem">
              <div class="routerIcon"><span class="icon" set:html={icons.list} /></div>
              <div class="routerCopy"><strong>Mixed-SKU RFQ</strong><span>When the buyer sends spreadsheets, screenshots, photos, or mixed lists.</span></div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </header>

  <section class="section compact">
    <div class="container">
      <div class="sectionHead" style="justify-content:center; text-align:center;">
        <div>
          <h2 class="sectionTitle">1. Choose the Entry Path Closest to Your RFQ</h2>
        </div>
      </div>
      <div class="entryGrid">
        {entryPaths.map((item) => (
          <article class="entryCard">
            <div class="entryMedia">
              <img src={item.image} alt={item.title} loading="eager" decoding="async" />
            </div>
            <div class="entryBody">
              <div class="entryHead">
                <span class="entryNo">{item.n}</span>
                <h3 class="entryTitle">{item.title}</h3>
              </div>
              <p class="entryText">{item.desc}</p>
              <div class="tagRow">
                {item.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <a class="textLink" href={item.href}>
                {item.cta}
                <span class="icon" set:html={icons.arrow} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="brand-entry">
    <div class="container">
      <div class="sectionHead">
        <div>
          <h2 class="sectionTitle">2. Start From the Truck Platform Your Buyer Already Knows</h2>
          <p class="sectionDesc">Use this path when the RFQ starts from brand, model, VIN, chassis number, or old supplier references.</p>
        </div>
      </div>

      <div class="brandArea">
        <div class="brandGrid" aria-label="Truck brand RFQ entries">
          {brands.map((brand) => (
            <a class="brandCard" href={brand.href}>
              <div class="brandLogo">
                <img src={brand.image} alt={`${brand.label} logo`} loading="eager" decoding="sync" />
              </div>
              <div class="brandMeta">
                <strong>{brand.label}</strong>
                <span>Start Brand RFQ -></span>
              </div>
            </a>
          ))}
        </div>

        <aside class="brandRfqCard">
          <div class="brandRfqIcon"><span class="icon" set:html={icons.file} /></div>
          <div>
            <h3>Not sure which brand?</h3>
            <p>Send what you have. We will review the matching scope first and guide the next RFQ path.</p>
          </div>
          <a class="btn" href="/contact">Send Mixed RFQ <span class="icon" set:html={icons.arrow} /></a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section alt" id="part-entry">
    <div class="container">
      <div class="sectionHead">
        <div>
          <h2 class="sectionTitle">3. Start From the Part System When the RFQ Is Category-led</h2>
          <p class="sectionDesc">Use this path when one inquiry covers one system across several brands, or for mixed-SKU replenishment. Common entry points include <a href="/product/part/brake-system-parts/">brake system parts</a>, <a href="/product/part/air-system-parts/">air system parts</a>, <a href="/product/part/axle-and-wheel-end-parts/">axle and wheel-end parts</a>, <a href="/product/part/clutch-and-transmission-parts/">gearbox and transmission parts</a>, and <a href="/product/part/cooling-system-parts/">cooling system parts</a>.</p>
        </div>
      </div>

      <div class="systemGrid" aria-label="Part system RFQ entries">
        {partSystems.map((item) => (
          <a class="systemCard" href={item.href}>
            <div class="systemMedia">
              <img src={item.image} alt={item.title} loading="eager" decoding="async" />
            </div>
            <div class="systemBody">
              <h3 class="systemTitle">{item.title}</h3>
              <p class="systemParts">{item.parts}</p>
              <p class="systemInput"><strong>Useful inputs:</strong>{item.input}</p>
              <span class="systemCta">{item.cta} -></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sectionHead">
        <div>
          <h2 class="sectionTitle">4. What to Send Before Matching Starts</h2>
        </div>
      </div>
      <div class="inputGrid">
        {sendInputs.map((item) => (
          <article class="inputCard">
            <div class="inputIcon"><span class="icon" set:html={icons[item.icon] ?? icons.file} /></div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="container">
      <div class="sectionHead">
        <div>
          <h2 class="sectionTitle">5. What Happens After You Send the Inquiry</h2>
        </div>
      </div>
      <div class="processRail" aria-label="RFQ processing steps">
        {process.map((step) => (
          <article class="processStep">
            <div class="processNo">{step.n}</div>
            <div class="processCopy">
              <h3>{step.title}</h3>
              <p>Output: {step.output}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="container">
      <div class="sectionHead">
        <div>
          <h2 class="sectionTitle">6. Real Truck Parts RFQs Rarely Start Clean</h2>
        </div>
      </div>
      <div class="messyWrap">
        {messyNotes.map((item) => (
          <article class="messyItem">
            <div class="messyIcon"><span class="icon" set:html={icons[item.icon] ?? icons.file} /></div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="container">
      <div class="productCta">
        <div class="ctaInner">
          <div>
            <h2 class="ctaTitle">Ready to Start Your RFQ?</h2>
            <p class="ctaText">Send the references you already have. We will clarify the matching scope before quotation starts.</p>
            <div class="ctaActions">
              <a class="btn primary" href="/contact">Send RFQ <span class="icon" set:html={icons.arrow} /></a>
              <a class="btn" href="/contact"><span class="icon" set:html={icons.whatsapp} /> Contact on WhatsApp</a>
            </div>
          </div>

          <div class="ctaFlow" aria-label="RFQ route summary">
            <div class="ctaStep"><div class="ctaIcon"><span class="icon" set:html={icons.file} /></div><span>Brand / System / List</span></div>
            <div class="ctaStep"><div class="ctaIcon"><span class="icon" set:html={icons.target} /></div><span>Matching Scope</span></div>
            <div class="ctaStep"><div class="ctaIcon"><span class="icon" set:html={icons.users} /></div><span>Supplier Comparison</span></div>
            <div class="ctaStep"><div class="ctaIcon"><span class="icon" set:html={icons.list} /></div><span>Quotation</span></div>
            <div class="ctaStep"><div class="ctaIcon"><span class="icon" set:html={icons.truck} /></div><span>QC & Shipment</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
