      .workflowGrid::before{
        display:none;
      }

      .caseGrid,
      .trustGrid{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 980px){
      .hero{
        min-height:auto;
      }

      .heroInner,
      .starterGrid,
      .finalInner{
        grid-template-columns:1fr;
      }

      .heroInner{
        gap:28px;
        padding:50px 0 42px;
        min-width:0;
      }

      .inputGrid,
      .buyerGrid,
      .workflowGrid{
        grid-template-columns:1fr;
        min-width:0;
      }

      .finalInner{
        padding:28px 22px;
      }

      .miniFlow{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .miniStep:not(:last-child)::after{
        display:none;
      }
    }

    @media (max-width: 640px){
      .container{
        width:calc(100% - 32px) !important;
        max-width:calc(100% - 32px) !important;
        margin-left:16px !important;
        margin-right:16px !important;
        overflow-x:hidden;
      }

      .hero,
      .section,
      .section.alt{
        width:100%;
        max-width:100%;
        overflow-x:hidden;
      }

      .section{
        padding:38px 0;
      }

      .sectionHead{
        align-items:flex-start;
      }

      .sectionTitle{
        font-size:24px;
      }

      .controlPanel{
        padding:22px 18px;
      }

      .heroTitle{
        font-size:clamp(27px, 7.2vw, 30px) !important;
        line-height:1.16 !important;
        max-width:100% !important;
        letter-spacing:-.01em !important;
      }

      .heroLead{
        font-size:15px !important;
        line-height:1.72 !important;
        max-width:100% !important;
      }

      .heroActions{
        gap:10px;
      }

      .heroActions .btn{
        flex:1 1 100%;
        padding:0 14px;
        min-width:0;
      }

      .heroInner,
      .heroCopy,
      .controlPanel,
      .workflowGrid,
      .stepCard,
      .inputGrid,
      .inputCard,
      .caseGrid,
      .caseCard,
      .buyerGrid,
      .buyerCard,
      .starterGrid,
      .starterBox,
      .starterActions,
      .finalCta,
      .finalInner,
      .miniFlow,
      .trustGrid,
      .trustCard{
        width:100%;
        max-width:100%;
        min-width:0;
      }

      .controlItem{
        grid-template-columns:42px minmax(0, 1fr);
        gap:12px;
      }

      .controlIcon{
        width:42px;
        height:42px;
      }

      .stepDesc,
      .inputDesc,
      .caseDesc,
      .trustDesc,
      .controlCopy span{
        overflow-wrap:anywhere;
      }

      .inputCard,
      .trustCard{
        grid-template-columns:1fr;
      }

      .caseGrid,
      .trustGrid,
      .miniFlow{
        grid-template-columns:1fr;
      }

      .starterText{
        padding:20px 0;
        font-size:13px;
      }

      .starterBox::before,
      .starterBox::after{
        display:none;
      }

      .actionCard{
        align-items:flex-start;
      }
    }
  </style>

  <header class="hero">
    <div class="heroGlow" aria-hidden="true"></div>
    <div class="container">
      <div class="heroInner">
        <div class="heroCopy">
          <p class="kicker">How It Works</p>
          <h1 class="heroTitle">How Your Truck Parts RFQ Moves From Inquiry to Shipment</h1>
          <p class="heroLead">
            Send the references you have. We clarify the matching scope, compare suppliers, organize quotations, and control QC, packing, documents, and shipment follow-up.
          </p>
          <div class="heroActions">
            <a class="btn primary" href="/contact">Send RFQ</a>
            <a class="btn" href="/capabilities">View Capabilities</a>
          </div>
        </div>

        <aside class="controlPanel" aria-label="RFQ control path">
          <h2 class="controlTitle">RFQ Control Path</h2>
          <div class="controlList">
            {controlPath.map((item) => (
              <div class="controlItem">
                <div class="controlIcon">
                  <span class="icon" set:html={icons[item.icon] ?? icons.check} />
                </div>
                <div class="controlCopy">
                  <strong>{item.title}</strong>
                  <span>{item.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </div>
  </header>

