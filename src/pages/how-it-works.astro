              Send what you have. We review the matching scope first, then move the RFQ into supplier comparison, quotation, and order follow-up.
            </p>
            <div class="heroActions">
              <a class="btn primary" href="/contact">Send RFQ</a>
              <a class="btn" href="/sourcing">View Sourcing Strategy</a>
            </div>
          </div>

          <div class="miniFlow" aria-label="RFQ summary flow">
            {workflowSteps.map((step) => (
              <div class="miniStep">
                <div class="miniIcon"><span class="icon" set:html={icons[step.icon] ?? icons.check} /></div>
