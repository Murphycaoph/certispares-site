const icons: Record<string, string> = {
  inbox: '<svg viewBox="0 0 24 24"><path d="M4 13h4l2 3h4l2-3h4"/><path d="M5 20h14a2 2 0 0 0 2-2v-5L18 5H6l-3 8v5a2 2 0 0 0 2 2Z"/></svg>',
