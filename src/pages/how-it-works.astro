            ))}
          </div>
        </div>
      </div>

      <div class="trustGrid">
        {trustPoints.map((item) => (
          <article class="trustCard">
            <div class="trustIcon"><span class="icon" set:html={icons[item.icon] ?? icons.check} /></div>
            <div>
              <h3 class="trustTitle">{item.title}</h3>
              <p class="trustDesc">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const copyButton = document.querySelector("[data-copy-rfq]");
    const starter = document.getElementById("rfq-starter");

    copyButton?.addEventListener("click", async () => {
      if (!starter?.textContent) return;

      try {
        await navigator.clipboard.writeText(starter.textContent.trim());
        copyButton.classList.add("isCopied");
        const label = copyButton.querySelector("span");
        if (label) label.textContent = "Copied";

        window.setTimeout(() => {
          copyButton.classList.remove("isCopied");
          if (label) label.textContent = "Copy RFQ starter";
        }, 1800);
      } catch (error) {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(starter);
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    });
  </script>
</BaseLayout>
