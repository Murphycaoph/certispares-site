const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How your truck parts RFQ moves from inquiry to shipment",
    description:
      "Structured RFQ intake, technical matching, supplier comparison, quotation consolidation, QC, packing, document control, and shipment follow-up for commercial vehicle aftermarket buyers.",
    step: workflowSteps.map((step) => ({
      "@type": "HowToStep",
      name: step.title,
      text: step.desc,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://certispares.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "How It Works",
        item: "https://certispares.com/how-it-works/",
      },
    ],
  },
];
---

<BaseLayout
  title="How CertiSpares Handles Truck Parts RFQs from China"
  description="See the workflow from RFQ clarification and supplier comparison to QC checkpoints, packing, documents, and shipment follow-up."
  keywords={["truck parts RFQ workflow", "commercial vehicle parts sourcing process", "truck parts supplier comparison", "truck parts quotation consolidation", "China truck parts sourcing"]}
  canonical="/how-it-works/"
  ogImage="/images/freight-truck-highway-sunset.webp"
  jsonLd={jsonLd}
>
  <style>
    :root{
      --page-bg:#f3f7fb;
      --ink:#102033;
      --muted:#5f6d86;
      --line:rgba(16,32,51,.10);
      --blue:#2365ff;
      --blue-strong:#1557f6;
      --blue-soft:#eaf1ff;
      --navy:#071226;
      --green:#25b66a;
      --amber:#f0a11c;
    }

    :global(main){
      background:
        linear-gradient(180deg, #f7fbff 0%, #eef4fa 54%, #f7fbff 100%);
      overflow-x:hidden;
    }

    .section{
      padding:48px 0;
      position:relative;
    }

    .section.alt{
      background:
        linear-gradient(135deg, rgba(35,101,255,.07), rgba(255,255,255,.72) 46%, rgba(37,182,106,.06));
      border-top:1px solid rgba(16,32,51,.06);
      border-bottom:1px solid rgba(16,32,51,.06);
    }

    .sectionHead{
      display:flex;
      align-items:flex-end;
      gap:16px;
      margin-bottom:24px;
    }

    .sectionIndex{
      display:inline-grid;
      place-items:center;
      width:38px;
      height:38px;
      color:#0b56f0;
      font-weight:950;
      font-size:24px;
      line-height:1;
      letter-spacing:-.03em;
      border-bottom:2px solid rgba(35,101,255,.36);
    }

    .sectionTitle{
      margin:0;
      color:#102033;
      font-size:28px;
      line-height:1.16;
      letter-spacing:-.02em;
    }

    .sectionDesc{
      margin:8px 0 0;
      max-width:780px;
      color:var(--muted);
      line-height:1.72;
    }

    .icon{
      width:28px;
      height:28px;
      display:inline-block;
      color:currentColor;
    }

    .icon :global(svg){
      width:100%;
      height:100%;
      display:block;
      stroke:currentColor;
      stroke-width:2;
      stroke-linecap:round;
      stroke-linejoin:round;
      fill:none;
    }

    .icon :global(path),
    .icon :global(circle),
    .icon :global(rect){
      stroke:currentColor;
      fill:none;
    }

    .hero{
      position:relative;
      overflow:hidden;
      isolation:isolate;
      background:#061121;
      min-height:560px;
      display:grid;
      align-items:center;
    }

    .hero::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-3;
      background:url("/images/freight-truck-highway-sunset.webp") center/cover no-repeat;
      filter:saturate(1.02) contrast(1.04) brightness(.78);
      transform:scale(1.04);
      animation:heroDrift 18s ease-in-out infinite alternate;
    }

    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:-2;
      background:
        linear-gradient(90deg, rgba(5,13,28,.95) 0%, rgba(5,13,28,.76) 42%, rgba(5,13,28,.34) 72%, rgba(5,13,28,.80) 100%),
        linear-gradient(180deg, rgba(5,13,28,.20) 0%, rgba(5,13,28,.86) 100%),
        radial-gradient(760px 420px at 28% 28%, rgba(35,101,255,.34), transparent 62%);
    }

    .heroGlow{
      position:absolute;
      inset:auto auto 0 0;
      width:70%;
      height:38%;
      z-index:-1;
      background:linear-gradient(90deg, rgba(35,101,255,.26), transparent);
      filter:blur(50px);
      opacity:.62;
      pointer-events:none;
    }

    .heroInner{
      display:grid;
      grid-template-columns:minmax(0, 1fr) minmax(340px, 420px);
      gap:48px;
      align-items:center;
      padding:68px 0 58px;
    }

    .heroCopy{
      max-width:760px;
      min-width:0;
      animation:riseIn .72s ease both;
    }

    .kicker{
      margin:0 0 16px;
      color:#4b83ff;
      font-size:13px;
      font-weight:950;
      letter-spacing:.14em;
      text-transform:uppercase;
    }

    .heroTitle{
      margin:0 0 18px;
      max-width:720px;
      color:#fff;
      font-size:clamp(42px, 5vw, 70px);
      line-height:1.05;
      letter-spacing:-.035em;
      overflow-wrap:break-word;
    }

    .heroLead{
      margin:0;
      max-width:660px;
      color:rgba(238,245,255,.88);
      font-size:17px;
      line-height:1.78;
      overflow-wrap:break-word;
    }

    .heroActions{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
      margin-top:28px;
    }

    .heroActions .btn.primary,
    .finalCta .btn.primary,
    .starterActions .whatsapp{
      color:#fff;
      background:var(--blue);
      border-color:var(--blue);
      box-shadow:0 16px 34px rgba(35,101,255,.26);
    }

    .heroActions .btn:not(.primary),
    .finalCta .btn:not(.primary){
      color:#fff;
      background:rgba(255,255,255,.08);
      border-color:rgba(255,255,255,.28);
      backdrop-filter:blur(8px);
    }

    .controlPanel{
      position:relative;
      min-width:0;
      padding:28px 28px 26px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.14);
      background:linear-gradient(180deg, rgba(10,31,62,.84), rgba(7,18,38,.74));
      box-shadow:0 24px 70px rgba(0,0,0,.34);
      backdrop-filter:blur(12px);
      animation:riseIn .78s .12s ease both;
      overflow:hidden;
    }

    .controlPanel::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(120deg, transparent 0%, rgba(255,255,255,.08) 30%, transparent 52%),
        radial-gradient(420px 180px at 18% 0%, rgba(35,101,255,.25), transparent 70%);
      opacity:.55;
      pointer-events:none;
    }

    .controlTitle{
      position:relative;
      margin:0 0 22px;
      color:#fff;
      font-size:20px;
      letter-spacing:-.02em;
    }

    .controlList{
      position:relative;
      display:grid;
      gap:18px;
    }

    .controlItem{
      position:relative;
      display:grid;
      grid-template-columns:44px 1fr;
      gap:14px;
      min-height:54px;
      animation:fadeSlide .56s ease both;
    }

    .controlItem:nth-child(2){ animation-delay:.12s; }
    .controlItem:nth-child(3){ animation-delay:.24s; }
    .controlItem:nth-child(4){ animation-delay:.36s; }
    .controlItem:nth-child(5){ animation-delay:.48s; }

    .controlItem:not(:last-child)::after{
      content:"";
      position:absolute;
      left:21px;
      top:46px;
      width:2px;
      height:28px;
      background:linear-gradient(180deg, rgba(74,131,255,.88), rgba(74,131,255,.10));
      box-shadow:0 0 18px rgba(35,101,255,.5);
      animation:pulseLine 2.4s ease-in-out infinite;
    }

    .controlIcon{
      width:44px;
      height:44px;
      border-radius:999px;
      display:grid;
      place-items:center;
      color:#fff;
      background:linear-gradient(180deg, #2b72ff, #1557f6);
      box-shadow:0 10px 26px rgba(35,101,255,.34);
    }

    .controlIcon .icon{
      width:22px;
      height:22px;
    }

    .controlCopy strong{
      display:block;
      margin:0 0 5px;
      color:#fff;
      font-size:14px;
      overflow-wrap:break-word;
    }

    .controlCopy span{
      display:block;
      color:rgba(236,243,255,.78);
      font-size:13px;
      line-height:1.55;
      overflow-wrap:break-word;
    }

    .workflowWrap{
      position:relative;
    }

    .workflowGrid{
      position:relative;
      display:grid;
      grid-template-columns:repeat(5, minmax(0, 1fr));
      gap:18px;
      align-items:stretch;
    }

    .workflowGrid::before{
      content:"";
      position:absolute;
      left:9%;
      right:9%;
      top:30px;
      height:2px;
      background:repeating-linear-gradient(90deg, rgba(35,101,255,.42) 0 8px, transparent 8px 15px);
      opacity:.78;
    }

    .stepCard{
      position:relative;
      min-width:0;
      min-height:292px;
      padding:0 18px 18px;
      border-radius:8px;
      background:rgba(255,255,255,.92);
      border:1px solid rgba(16,32,51,.08);
      box-shadow:0 18px 42px rgba(18,35,64,.08);
      transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
      animation:riseIn .58s ease both;
    }

    .stepCard:nth-child(2){ animation-delay:.06s; }
    .stepCard:nth-child(3){ animation-delay:.12s; }
    .stepCard:nth-child(4){ animation-delay:.18s; }
    .stepCard:nth-child(5){ animation-delay:.24s; }

    .stepCard:hover{
      transform:translateY(-8px);
      border-color:rgba(35,101,255,.32);
      box-shadow:0 24px 58px rgba(35,101,255,.14);
    }

    .stepNumber{
      width:42px;
      height:42px;
      display:grid;
      place-items:center;
      margin:-1px 0 22px;
      border-radius:0 0 999px 999px;
      color:#fff;
      background:linear-gradient(180deg, #2c72ff, #1457f2);
      font-weight:950;
      font-size:13px;
      box-shadow:0 14px 28px rgba(35,101,255,.26);
    }

    .stepIcon{
      width:52px;
      height:52px;
      display:grid;
      place-items:center;
      margin-bottom:18px;
      color:#2365ff;
      border-radius:999px;
      background:radial-gradient(circle at 30% 20%, #fff 0%, #edf4ff 100%);
      border:1px solid rgba(35,101,255,.14);
      box-shadow:0 12px 26px rgba(35,101,255,.10);
      transition:transform .22s ease, color .22s ease;
    }

    .stepCard:hover .stepIcon{
      transform:scale(1.08);
      color:#0d4ee8;
    }

    .stepIcon .icon{
      width:28px;
      height:28px;
    }

    .stepTitle{
      margin:0 0 10px;
      color:#102033;
      font-size:17px;
      line-height:1.28;
      letter-spacing:-.02em;
    }

    .stepDesc{
      margin:0;
      color:#4f6077;
      font-size:14px;
      line-height:1.68;
    }

    .outputTag{
      margin-top:18px;
      padding:10px 12px;
      border-radius:6px;
      background:#eaf1ff;
      color:#1557f6;
      font-size:13px;
      font-weight:900;
      line-height:1.4;
    }

    .inputGrid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:16px;
    }

    .inputCard{
      display:grid;
      grid-template-columns:58px 1fr;
      gap:16px;
      align-items:center;
      min-width:0;
      min-height:126px;
      padding:20px;
      border-radius:8px;
      background:rgba(255,255,255,.82);
      border:1px solid rgba(16,32,51,.12);
      box-shadow:0 14px 34px rgba(18,35,64,.05);
      transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .inputCard:hover{
      transform:translateY(-4px);
      border-color:rgba(35,101,255,.26);
      box-shadow:0 20px 44px rgba(18,35,64,.09);
    }

    .inputIcon,
    .caseIcon{
      width:58px;
      height:58px;
      border-radius:999px;
      display:grid;
      place-items:center;
      color:#2365ff;
      background:#f2f6ff;
      border:1px solid rgba(35,101,255,.14);
      transition:transform .2s ease;
    }

    .inputCard:hover .inputIcon{
      transform:scale(1.08) rotate(-2deg);
    }

    .inputTitle{
      margin:0 0 6px;
