      </div>

      <div class="workflowWrap">
        <div class="workflowGrid">
          {workflowSteps.map((step) => (
            <article class="stepCard">
              <div class="stepNumber">{step.n}</div>
              <div class="stepIcon"><span class="icon" set:html={icons[step.icon] ?? icons.check} /></div>
              <h3 class="stepTitle">{step.title}</h3>
              <p class="stepDesc">{step.desc}</p>
              <div class="outputTag">Output: {step.output}</div>
