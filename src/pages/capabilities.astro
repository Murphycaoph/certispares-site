const starterMessage = `Hello CertiSpares, I want to check if my truck parts RFQ fits your capability model.

Photos / OE numbers / list available:
Truck brand or model:
Quantity:
Destination:
Main concern: scope / supplier comparison / QC / documents / shipment`;

const whatsappUrl = `https://wa.me/${WHATSAPP_E164}?text=${encodeURIComponent(starterMessage)}`;
const emailUrl = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Truck parts RFQ capability review")}&body=${encodeURIComponent(starterMessage)}`;

const icons = {
  target: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>',
  file: '<svg viewBox="0 0 24 24"><path d="M5 3h10l4 4v14H5Z"/><path d="M15 3v5h5"/><path d="M8 13h8M8 17h6"/></svg>',
  eye: '<svg viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>',
  scope: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/><path d="M7 12h2M15 12h2"/></svg>',
  users: '<svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-8 0v2"/><circle cx="12" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M2 21v-2a4 4 0 0 1 3-3.87"/></svg>',
  qc: '<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-5"/></svg>',
  label: '<svg viewBox="0 0 24 24"><path d="M4 7V4h3"/><path d="M17 4h3v3"/><path d="M20 17v3h-3"/><path d="M7 20H4v-3"/><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M9 11h6M9 14h4"/></svg>',
  document: '<svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6Z"/><path d="M15 3v4h4"/><path d="m9 14 2 2 4-5"/><path d="M9 9h5"/></svg>',
  logistics: '<svg viewBox="0 0 24 24"><path d="M3 7h11v10H3Z"/><path d="M14 11h4l3 3v3h-7Z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 10h5"/></svg>',
  box: '<svg viewBox="0 0 24 24"><path d="m21 8-9-5-9 5 9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>',
  gears: '<svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="16" cy="16" r="3"/><path d="M8 2v3M8 11v3M2 8h3M11 8h3M16 10v3M16 19v3M10 16h3M19 16h3"/></svg>',
  container: '<svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="10" rx="1"/><path d="M7 7v10M11 7v10M15 7v10"/><path d="M5 20h14"/></svg>',
  note: '<svg viewBox="0 0 24 24"><path d="M5 3h14v18H5Z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>',
  chat: '<svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-8 8H7l-4 2 1.4-4A8 8 0 1 1 21 12Z"/></svg>',
  factory: '<svg viewBox="0 0 24 24"><path d="M3 21V9l6 4V9l6 4V5h6v16Z"/><path d="M7 17h2M12 17h2M17 17h2"/><path d="m4 4 16 16"/></svg>',
  shield: '<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-5"/></svg>',
  list: '<svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>',
  whatsapp: '<svg viewBox="0 0 24 24"><path d="M20 11.8a8 8 0 0 1-11.7 7.1L4 20l1.2-4.1A8 8 0 1 1 20 11.8Z"/><path d="M9.2 8.3c.2-.4.4-.5.7-.5h.5c.2 0 .4.1.5.4l.8 1.8c.1.3.1.5-.1.7l-.4.5c-.1.2-.1.3 0 .5.4.8 1.1 1.5 2 2 .2.1.3.1.5-.1l.6-.7c.2-.2.4-.2.7-.1l1.7.8c.3.1.5.3.5.6 0 .5-.3 1.2-.7 1.5-.5.4-1.7.5-3.3-.2-2.7-1.2-4.5-3.8-4.7-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.1.7-1.8 1-2Z"/></svg>',
  mail: '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
};

const controlAreas = [
  { title: "RFQ Scope Review", text: "Check fitment, OE reference, photo, and category scope.", icon: "scope" },
  { title: "Supplier Comparison", text: "Compare supplier fit, MOQ, lead time, price, and risk.", icon: "users" },
  { title: "QC Checkpoints", text: "Sampling, appearance, quantity, labels, and photo evidence.", icon: "qc" },
  { title: "Packing & Label Control", text: "Verify packing methods, labels, carton marks, and protection.", icon: "label" },
  { title: "Document Consistency", text: "Keep PI, CI, PL, labels, and carton marks consistent.", icon: "document" },
  { title: "Consolidation & Logistics", text: "Plan container loading, export shipping, and delivery follow-up.", icon: "logistics" },
];

const overviewCards = [
  {
    title: "Application-Based Coverage",
    text: "Light-, medium-, and heavy-duty truck RFQs are reviewed through platform, OE reference, part photo, and category fit.",
    icon: "target",
  },
  {
    title: "Quote Basis Before Decision",
    text: "Supplier comparison, MOQ, lead time, packing basis, and replacement risk are organized before buyer commitment.",
    icon: "file",
  },
  {
    title: "Visible Execution After Selection",
    text: "Inspection checkpoints, document control, consolidation planning, and logistics follow-up stay connected after supplier selection.",
    icon: "eye",
  },
];

const capabilityCards = [
  {
    n: "01",
    title: "Coverage Scope",
    icon: "logistics",
    check: "Truck segment, platform, OE reference, part photo, and category fit.",
    use: "Light-, medium-, and heavy-duty truck RFQs with stronger depth in heavy-duty platforms.",
    output: "Clear coverage confirmation before supplier outreach.",
  },
  {
    n: "02",
    title: "Product Range",
    icon: "gears",
    check: "Engine, drivetrain, chassis, steering, axle, brake, suspension, wear parts, and mixed items.",
    use: "Mixed-SKU replenishment and platform-based aftermarket sourcing.",
    output: "Category organization and item-level scope map.",
  },
  {
    n: "03",
    title: "Supplier Network",
    icon: "users",
    check: "Supplier type, category fit, production feasibility, delivery consistency, and document responsiveness.",
    use: "Avoiding first-available supplier decisions.",
    output: "Shortlisted supplier options with comparison notes.",
  },
  {
    n: "04",
    title: "Quality Control",
    icon: "qc",
    check: "Sampling, appearance, quantity, function, labels, carton marks, and photo evidence.",
    use: "Reducing avoidable mismatch before shipment.",
    output: "QC photos, check reports, and pre-release confirmation.",
  },
  {
    n: "05",
    title: "Document Control",
    icon: "document",
    check: "PI, invoice, packing list, item names, quantities, carton marks, and consignee details.",
    use: "Keeping goods, labels, and export paperwork consistent.",
    output: "Document cross-check and consistency confirmation.",
  },
  {
    n: "06",
    title: "Consolidation & Logistics",
    icon: "container",
    check: "Multi-supplier cargo, loading plan, dispatch milestones, shipment readiness, and delivery follow-up.",
    use: "Supporting lower landed cost and cleaner mixed-SKU shipments.",
    output: "Consolidation plan and shipment status updates.",
  },
];

const outputCards = [
  { title: "Coverage Confirmation", text: "Which platform, OE reference, product detail, or visible feature is being used before supplier outreach.", icon: "target" },
  { title: "Supplier Comparison Notes", text: "Capability, lead time, MOQ, price level, packing basis, and execution notes.", icon: "users" },
  { title: "Quotation Clarification Notes", text: "Open questions, replacement risks, unclear references, and assumptions to confirm.", icon: "chat" },
  { title: "QC & Packing Checkpoints", text: "Photo evidence, quantity check, label / carton mark confirmation, and packing review.", icon: "qc" },
  { title: "Document Consistency Check", text: "PI, invoice, packing list, item names, quantities, carton marks, and consignee details.", icon: "document" },
  { title: "Consolidation & Shipment Status", text: "Loading plan visibility, export progress, and delivery follow-up through shipment milestones.", icon: "logistics" },
];

const handoffs = [
  {
    n: "01",
    stage: "Before Quotation",
    buyer: ["OE number, VIN/chassis", "Photos and part details", "Quantity and demand plan", "Destination and Incoterms", "Packing requirements"],
    checks: ["Part scope and category", "Supplier type and capability", "Replacement risk", "Quote assumptions", "Open unknowns"],
  },
  {
    n: "02",
    stage: "Before Order",
    buyer: ["Item selection", "Target terms", "Label rules and branding", "Acceptable alternatives", "Payment / order notes"],
    checks: ["Supplier quote basis", "MOQ, lead time, packing", "Payment / order details", "Production feasibility"],
  },
  {
    n: "03",
    stage: "Before Shipment",
    buyer: ["Final documents approval", "Carton marks", "Consignee details", "Dispatch plan", "Special packing needs"],
    checks: ["Packing evidence", "Document consistency", "Loading plan", "Shipment milestones"],
  },
];

const boundaries = [
  { title: "We Are Not a Factory", text: "We organize sourcing, comparison, QC, and shipment follow-up. Production remains with approved suppliers.", icon: "factory" },
  { title: "No Unrealistic Claims", text: "We do not promise the cheapest option every time. We optimize for fit, execution, and predictable delivery.", icon: "shield" },
  { title: "QC Scope Is Defined Per Order", text: "Inspection checkpoints depend on product type, order value, risk level, and buyer requirements.", icon: "list" },
  { title: "Traceable Paperwork Matters", text: "Invoices, packing lists, item names, labels, carton marks, and quantities should remain consistent.", icon: "document" },
];

const ctaFlow = ["RFQ Input", "Scope Review", "Supplier Comparison", "QC / Documents", "Shipment Follow-up"];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Truck Parts Sourcing Capabilities From RFQ to Shipment",
    description:
      "Capability matrix for commercial vehicle aftermarket sourcing support, including RFQ scope review, supplier comparison, QC checkpoints, document control, consolidation, and shipment follow-up.",
    url: "https://certispares.com/capabilities/",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Commercial vehicle parts sourcing capability support",
    provider: {
      "@type": "Organization",
      name: "CertiSpares",
      url: "https://certispares.com/",
    },
    areaServed: "Worldwide",
    description:
      "RFQ-first sourcing support covering matching scope review, supplier comparison, QC checkpoints, packing and document control, consolidation planning, and shipment follow-up from China.",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://certispares.com/" },
      { "@type": "ListItem", position: 2, name: "Capabilities", item: "https://certispares.com/capabilities/" },
    ],
  },
];
---

<BaseLayout
  title="Truck Parts Sourcing Capabilities | QC, Packing & Consolidation"
  description="Explore CertiSpares capabilities across supplier comparison, QC checkpoints, packing follow-up, document coordination, and shipment consolidation."
  keywords={["truck parts sourcing capabilities", "truck parts QC checkpoints", "supplier comparison China", "commercial vehicle parts document control"]}
  canonical="/capabilities/"
  ogImage="/images/container-loading-supervision.webp"
  jsonLd={jsonLd}
>
  <style>
    :root{
      --cap-navy:#061735;
      --cap-ink:#071b42;
      --cap-text:#52627d;
      --cap-line:#dce4ef;
      --cap-blue:#1f66ff;
      --cap-green:#12a86c;
      --cap-bg:#eef3f8;
      --cap-card:#fff;
    }

    :global(main){
      background:transparent;
    }

    :global(.capabilitiesHero svg *),
    :global(.capBody svg *){
      fill:none;
      stroke:currentColor;
      stroke-width:1.9;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .capabilitiesHero{
      position:relative;
      overflow:hidden;
      color:#fff;
      background:
        linear-gradient(90deg, rgba(4,17,42,.96) 0%, rgba(4,17,42,.78) 48%, rgba(4,17,42,.96) 100%),
        linear-gradient(180deg, rgba(4,17,42,.12), rgba(4,17,42,.78)),
        url("/images/container-loading-supervision.webp") center/cover no-repeat,
        #061735;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .heroInner{
      display:grid;
      grid-template-columns:minmax(0, .9fr) minmax(390px, .82fr);
      gap:48px;
      align-items:center;
      min-height:520px;
      padding:58px 0;
      position:relative;
      z-index:1;
    }

    .eyebrow{
      margin:0 0 14px;
      color:#58a0ff;
      font-size:13px;
      font-weight:900;
      letter-spacing:.08em;
      text-transform:uppercase;
    }

    .heroCopy h1{
      max-width:760px;
      margin:0;
      color:#fff;
      font-size:56px;
      line-height:1.08;
      letter-spacing:0;
    }

    .heroCopy p{
      max-width:720px;
      margin:22px 0 0;
      color:rgba(238,246,255,.9);
      font-size:18px;
      line-height:1.65;
    }

    .heroActions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:28px;
    }

    .actionBtn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      min-height:50px;
      padding:0 24px;
      border-radius:6px;
      font-size:14px;
      font-weight:900;
      text-decoration:none;
      transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .actionBtn span{
      width:20px;
      height:20px;
      display:inline-flex;
    }

    .actionBtn.primary{
      color:#fff;
      background:linear-gradient(135deg, #0ebc78, #07975f);
      box-shadow:0 14px 30px rgba(9,151,95,.24);
    }

    .actionBtn.secondary{
      color:#fff;
      border:1px solid rgba(255,255,255,.38);
      background:rgba(255,255,255,.05);
    }

    .actionBtn:hover{
      transform:translateY(-1px);
    }

    .controlPanel{
      padding:28px;
      border:1px solid rgba(255,255,255,.24);
      border-radius:8px;
      background:rgba(5,20,48,.72);
      box-shadow:0 24px 70px rgba(0,0,0,.22);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
    }

    .controlPanel h2{
      margin:0 0 20px;
      color:#fff;
      font-size:22px;
      letter-spacing:0;
    }

    .controlGrid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:16px;
    }

    .controlItem{
      display:grid;
      grid-template-columns:44px minmax(0, 1fr);
      gap:12px;
      align-items:start;
      padding:12px;
      border-radius:8px;
      background:rgba(255,255,255,.045);
      border:1px solid rgba(255,255,255,.08);
    }

    .controlItem strong{
      display:block;
      margin-bottom:4px;
      color:#fff;
      font-size:14px;
      line-height:1.25;
    }

    .controlItem span:last-child{
      color:rgba(230,239,255,.78);
      font-size:12px;
      line-height:1.45;
    }

    .iconBox{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:44px;
      height:44px;
      border-radius:8px;
      color:var(--cap-blue);
      background:#eef5ff;
      border:1px solid rgba(31,102,255,.2);
      flex:0 0 auto;
    }

    .controlItem .iconBox{
      color:#37d58d;
      background:rgba(11,169,109,.14);
      border-color:rgba(55,213,141,.24);
    }

    .capBody{
      background:linear-gradient(180deg, #f8fbff 0%, var(--cap-bg) 100%);
      color:var(--cap-ink);
    }

    .sectionBlock{
      padding:34px 0;
    }

    .sectionHeader{
      max-width:880px;
      margin:0 auto 22px;
      text-align:center;
    }

    .sectionHeader.left{
      margin:0 0 22px;
      text-align:left;
    }

    .sectionHeader h2{
      margin:0;
      color:var(--cap-ink);
      font-size:31px;
      line-height:1.18;
      letter-spacing:0;
    }

    .sectionHeader h2 span{
      color:var(--cap-blue);
    }

    .sectionHeader p{
      margin:12px 0 0;
      color:var(--cap-text);
      font-size:16px;
      line-height:1.62;
    }

    .overviewGrid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:18px;
    }

    .overviewCard,
    .matrixCard,
    .outputCard,
    .handoffCard,
    .boundaryCard{
      border:1px solid var(--cap-line);
      border-radius:8px;
      background:var(--cap-card);
      box-shadow:0 12px 30px rgba(17,31,67,.05);
    }

    .overviewCard{
      display:grid;
      grid-template-columns:72px minmax(0, 1fr);
      gap:18px;
      align-items:start;
      min-height:150px;
      padding:24px;
    }

    .overviewCard .iconBox{
      width:64px;
      height:64px;
      color:#fff;
      background:linear-gradient(135deg, #2074ff, #115be5);
      border-color:transparent;
      box-shadow:0 14px 28px rgba(31,102,255,.18);
    }

    h3{
      margin:0;
      color:var(--cap-ink);
      font-size:17px;
      line-height:1.28;
      letter-spacing:0;
    }

    p{
      letter-spacing:0;
    }

    .overviewCard p,
    .matrixCard p,
    .outputCard p,
    .boundaryCard p{
      margin:8px 0 0;
      color:var(--cap-text);
      font-size:14px;
      line-height:1.56;
    }

    .matrixGrid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:18px;
    }

    .matrixCard{
      position:relative;
      display:grid;
      grid-template-columns:88px minmax(0, 1fr);
      gap:18px;
      min-height:330px;
      padding:24px;
      overflow:hidden;
    }

    .matrixNo{
      position:absolute;
      top:18px;
      left:18px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:34px;
      height:24px;
      padding:0 8px;
      border-radius:5px;
      color:#fff;
      background:var(--cap-blue);
      font-size:12px;
      font-weight:900;
    }

    .matrixIcon{
      width:72px;
      height:72px;
      margin-top:54px;
      color:var(--cap-blue);
    }

    .matrixText h3{
      margin-bottom:16px;
    }

    .miniLabel{
      display:block;
      margin:13px 0 3px;
      color:var(--cap-ink);
      font-size:12px;
      font-weight:900;
      line-height:1.25;
    }

    .economicsBand{
      position:relative;
      overflow:hidden;
      display:grid;
      grid-template-columns:minmax(0, .85fr) minmax(0, 1.2fr) auto;
      gap:22px;
      align-items:center;
      padding:26px;
      border-radius:8px;
      color:#fff;
      background:
        linear-gradient(90deg, rgba(5,20,48,.98), rgba(5,20,48,.9)),
        url("/images/port-container-loading-night.webp") center/cover no-repeat;
      box-shadow:0 20px 50px rgba(7,31,67,.16);
    }

    .economicsBand h2{
      margin:0 0 10px;
      color:#fff;
      font-size:27px;
      line-height:1.18;
    }

    .economicsBand p{
      margin:0;
      color:rgba(238,246,255,.84);
      font-size:14px;
      line-height:1.58;
    }

    .economicsCards{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:14px;
    }

    .economicsCard{
      display:grid;
      grid-template-columns:108px minmax(0, 1fr);
      gap:14px;
      align-items:center;
      padding:12px;
      border:1px solid rgba(255,255,255,.12);
      border-radius:8px;
      background:rgba(255,255,255,.06);
    }

    .economicsImage{
      min-height:110px;
      border-radius:6px;
      background:var(--img) center/cover no-repeat;
    }

    .economicsCard strong{
      display:block;
      margin-bottom:6px;
      color:#fff;
      font-size:14px;
    }

    .outputGrid{
      display:grid;
      grid-template-columns:repeat(6, minmax(0, 1fr));
      gap:14px;
    }

    .outputCard{
      min-height:210px;
      padding:22px 16px;
      text-align:center;
    }

    .outputCard .iconBox{
      margin:0 auto 14px;
      width:56px;
      height:56px;
      background:#f5f9ff;
    }

    .handoffGrid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:18px;
    }

    .handoffCard{
      padding:20px;
    }

    .handoffTitle{
      display:flex;
      align-items:center;
      gap:10px;
      margin-bottom:16px;
    }

    .handoffNo{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:34px;
      height:34px;
      border-radius:999px;
      color:#fff;
      background:var(--cap-blue);
      font-size:12px;
      font-weight:900;
    }

    .handoffCols{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:16px;
    }

    .handoffCols strong{
      display:block;
      margin-bottom:8px;
      color:var(--cap-ink);
      font-size:13px;
    }

    .checkList{
      display:grid;
      gap:7px;
      margin:0;
      padding:0;
      list-style:none;
    }

    .checkList li{
      position:relative;
      padding-left:18px;
      color:var(--cap-text);
      font-size:12px;
      line-height:1.42;
    }

    .checkList li::before{
      content:"";
      position:absolute;
      left:0;
      top:.38em;
      width:8px;
      height:8px;
      border-radius:999px;
      background:#e5f6ef;
      border:1px solid var(--cap-green);
    }

    .boundaryGrid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:14px;
    }

    .boundaryCard{
      display:grid;
      grid-template-columns:64px minmax(0, 1fr);
      gap:16px;
      padding:20px;
      min-height:148px;
    }

    .boundaryCard .iconBox{
      width:58px;
      height:58px;
    }

    .finalCta{
      position:relative;
      overflow:hidden;
      border-radius:8px;
      padding:34px;
      color:#fff;
      background:
        linear-gradient(90deg, rgba(5,20,48,.98), rgba(5,20,48,.86)),
        url("/images/logistics-container-export-port.webp") center/cover no-repeat;
      box-shadow:0 20px 50px rgba(7,31,67,.16);
    }

    .finalInner{
      display:grid;
      grid-template-columns:minmax(0, .9fr) minmax(360px, .9fr);
      gap:28px;
      align-items:center;
    }

    .finalCta h2{
      max-width:560px;
      margin:0;
      color:#fff;
      font-size:30px;
      line-height:1.16;
    }

    .finalCta h2 span{
      color:#4fdf98;
    }

    .finalCta p{
      max-width:680px;
      margin:12px 0 0;
      color:rgba(238,246,255,.86);
      font-size:15px;
      line-height:1.62;
    }

    .ctaFlow{
      display:grid;
      grid-template-columns:repeat(5, minmax(0, 1fr));
      gap:10px;
      align-items:start;
    }

    .ctaStep{
      position:relative;
      display:grid;
      justify-items:center;
      gap:8px;
      color:rgba(238,246,255,.9);
      font-size:12px;
      font-weight:900;
      text-align:center;
    }

    .ctaStep::after{
      content:"";
      position:absolute;
      top:18px;
      left:calc(50% + 25px);
      width:calc(100% - 50px);
      height:1px;
      background:rgba(79,223,152,.55);
    }

    .ctaStep:last-child::after{
      display:none;
    }

    .ctaDot{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:38px;
      height:38px;
      border-radius:999px;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.24);
      color:#fff;
    }

    @media (max-width:1180px){
      .heroInner,
      .finalInner,
      .economicsBand{
        grid-template-columns:1fr;
      }

      .controlGrid,
      .economicsCards{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .matrixGrid,
      .handoffGrid{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .outputGrid,
      .boundaryGrid{
        grid-template-columns:repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width:820px){
      .heroInner{
        min-height:auto;
        padding:46px 0 36px;
      }

      .heroCopy h1{
        font-size:36px;
      }

      .heroCopy p{
        font-size:16px;
      }

      .controlGrid,
      .overviewGrid,
      .matrixGrid,
      .outputGrid,
      .handoffGrid,
      .boundaryGrid,
      .handoffCols,
      .economicsCards,
      .ctaFlow{
        grid-template-columns:1fr;
      }

      .overviewCard,
      .matrixCard,
      .boundaryCard{
        grid-template-columns:1fr;
      }

      .matrixIcon{
        margin-top:38px;
      }

      .economicsBand,
      .finalCta,
      .controlPanel{
        padding:22px;
      }

      .economicsCard{
        grid-template-columns:1fr;
      }

      .economicsImage{
        min-height:150px;
      }

      .sectionBlock{
        padding:26px 0;
      }

      .sectionHeader{
        text-align:left;
      }

      .sectionHeader h2{
        font-size:26px;
      }

      .ctaStep::after{
        display:none;
      }
    }
  </style>

  <header class="capabilitiesHero">
    <div class="container wide heroInner">
      <div class="heroCopy">
        <p class="eyebrow">Our Capabilities</p>
        <h1>Truck Parts Sourcing Capabilities From RFQ to Shipment</h1>
        <p>
          We help buyers keep sourcing decisions visible before quotation, before order release, and before shipment:
          from matching scope and supplier comparison to QC, packing, documents, and logistics follow-up.
        </p>
        <div class="heroActions">
          <a class="actionBtn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <span set:html={icons.whatsapp}></span>
            Chat on WhatsApp
          </a>
          <a class="actionBtn secondary" href="/product">Start Parts RFQ <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>

      <aside class="controlPanel" aria-label="Capability control areas">
        <h2>Capability Control Areas</h2>
        <div class="controlGrid">
          {controlAreas.map((item) => (
            <div class="controlItem">
              <span class="iconBox" aria-hidden="true" set:html={icons[item.icon]}></span>
              <span>
                <strong>{item.title}</strong>
                {item.text}
              </span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </header>

  <main class="capBody">
    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>What Our Capability Model Controls</h2>
      </div>
      <div class="overviewGrid">
        {overviewCards.map((card) => (
          <article class="overviewCard">
            <span class="iconBox" aria-hidden="true" set:html={icons[card.icon]}></span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>Capability <span>Matrix</span></h2>
      </div>
      <div class="matrixGrid">
        {capabilityCards.map((card) => (
          <article class="matrixCard">
            <span class="matrixNo">{card.n}</span>
            <span class="matrixIcon" aria-hidden="true" set:html={icons[card.icon]}></span>
            <div class="matrixText">
              <h3>{card.title}</h3>
              <span class="miniLabel">What we check</span>
              <p>{card.check}</p>
              <span class="miniLabel">Typical use</span>
              <p>{card.use}</p>
              <span class="miniLabel">Output</span>
              <p>{card.output}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="economicsBand">
        <div>
          <h2>Capabilities Support Better Sourcing Economics</h2>
          <p>
            Capability control is not only about avoiding mistakes. Supplier comparison, packing control,
            document consistency, and consolidation planning also help buyers build more practical shipments
            and healthier turnover with the same budget.
          </p>
        </div>
        <div class="economicsCards">
          <article class="economicsCard">
            <div class="economicsImage" style="--img:url('/images/sourcing/compare-container-ship.webp')"></div>
            <div>
              <strong>Container Consolidation</strong>
              <p>Combine cargo from multiple suitable suppliers under one coordinated shipment path.</p>
            </div>
          </article>
          <article class="economicsCard">
            <div class="economicsImage" style="--img:url('/images/sourcing/advantage-warehouse-shelves.webp')"></div>
            <div>
              <strong>Balanced SKU Sourcing</strong>
              <p>Avoid overbuying narrow product lines just to fill space. Build a better mix of fast- and medium-moving SKUs.</p>
            </div>
          </article>
        </div>
        <a class="actionBtn secondary" href="/sourcing">View Sourcing Strategy <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>What Buyers <span>Receive</span></h2>
      </div>
      <div class="outputGrid">
        {outputCards.map((card) => (
          <article class="outputCard">
            <span class="iconBox" aria-hidden="true" set:html={icons[card.icon]}></span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>Who Confirms What</h2>
        <p>Good sourcing work depends on clean handoffs. We keep buyer input and CertiSpares checks visible at each stage.</p>
      </div>
      <div class="handoffGrid">
        {handoffs.map((card) => (
          <article class="handoffCard">
            <div class="handoffTitle">
              <span class="handoffNo">{card.n}</span>
              <h3>{card.stage}</h3>
            </div>
            <div class="handoffCols">
              <div>
                <strong>Buyer confirms</strong>
                <ul class="checkList">
                  {card.buyer.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <strong>CertiSpares checks</strong>
                <ul class="checkList">
                  {card.checks.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <h2>Service Boundaries That Keep Cooperation Clear</h2>
      </div>
      <div class="boundaryGrid">
        {boundaries.map((card) => (
          <article class="boundaryCard">
            <span class="iconBox" aria-hidden="true" set:html={icons[card.icon]}></span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="finalCta">
        <div class="finalInner">
          <div>
            <h2>Want to check if your RFQ fits this <span>capability model?</span></h2>
            <p>
              Send photos, OE numbers, VIN/model details, old supplier lists, or a mixed parts sheet.
              We will review what you have, ask clarification questions, and confirm the next workable sourcing step through conversation.
            </p>
            <div class="heroActions">
              <a class="actionBtn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                <span set:html={icons.whatsapp}></span>
                Chat on WhatsApp
              </a>
              <a class="actionBtn secondary" href={emailUrl}>
                <span set:html={icons.mail}></span>
                Send by Email
              </a>
            </div>
          </div>
          <div class="ctaFlow" aria-label="Capability conversation path">
            {ctaFlow.map((item, index) => (
              <div class="ctaStep">
                <span class="ctaDot">{String(index + 1).padStart(2, "0")}</span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
