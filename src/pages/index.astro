---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getImageDimensions } from "../lib/imageDimensions";

const rawPosts = await getCollection("blog");

rawPosts.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));

const insights = rawPosts.slice(0, 3).map((p) => ({
  title: p.data.title,
  tag: p.data.tag ?? "Insights",
  excerpt: p.data.excerpt ?? "",
  href: `/blog/${p.slug}`,
}));

const heroImage = {
  src: "/images/homepage/homepage-hero-truck.webp",
  ...getImageDimensions("/images/homepage/homepage-hero-truck.webp"),
};

const whatsappUrl = "https://wa.me/8615633022618?text=Hello%20CertiSpares%2C%20I%20want%20to%20send%20OE%20%2F%20VIN%20%2F%20photos%20for%20a%20parts%20inquiry.";

const rfqFlowCards = [
  {
    step: "Send RFQ",
    title: "Share the buying context",
    desc: "Send part lists, OE numbers, photos, quantities, destination, or vehicle details.",
  },
  {
    step: "Clarify",
    title: "Confirm parts before price",
    desc: "We check references, fitment notes, specifications, samples, and quotation scope.",
  },
  {
    step: "Compare",
    title: "Match suppliers to execution",
    desc: "Options are compared by price, MOQ, lead time, category fit, and risk.",
  },
  {
    step: "Control",
    title: "Review order checkpoints",
    desc: "Samples, packing, labels, documents, and QC details are controlled before shipment.",
  },
  {
    step: "Consolidate",
    title: "Ship a practical order mix",
    desc: "Mixed SKUs and suppliers are coordinated into repeatable, cost-aware shipments.",
  },
];

const productBrands = [
  { name: "Foton", image: "/images/generated-brand-logos/foton.webp", alt: "Foton logo" },
  { name: "HOWO", image: "/images/generated-brand-logos/howo.webp", alt: "HOWO logo" },
  { name: "JAC", image: "/images/generated-brand-logos/jac.webp", alt: "JAC logo" },
  { name: "Dongfeng", image: "/images/generated-brand-logos/dongfeng.webp", alt: "Dongfeng logo" },
  { name: "Sinotruk", image: "/images/generated-brand-logos/sinotruk.webp", alt: "Sinotruk logo" },
  { name: "Shacman", image: "/images/generated-brand-logos/shacman.webp", alt: "Shacman logo" },
  { name: "FAW", image: "/images/generated-brand-logos/faw.webp", alt: "FAW logo" },
  { name: "MAN", image: "/images/generated-brand-logos/man.webp", alt: "MAN logo" },
  { name: "Mercedes-Benz Truck", image: "/images/generated-brand-logos/mercedes-benz-truck.webp", alt: "Mercedes-Benz Truck logo" },
  { name: "Volvo Truck", image: "/images/generated-brand-logos/volvo-truck.webp", alt: "Volvo Truck logo" },
];

const strategyCards = [
  {
    title: "Lower landed cost through consolidation",
    desc: "One container can combine multiple required products from multiple suppliers, helping buyers avoid shipping partially optimized orders and reducing the logistics cost carried by each SKU.",
    image: "/images/homepage/homepage-landed-cost.webp",
    bullets: [
      "Multi-supplier loading into one container",
      "Better freight allocation across the order mix",
      "More commercial control than shipping each factory order separately",
    ],
    href: "/sourcing",
  },
  {
    title: "Faster turnover through balanced SKU sourcing",
    desc: "Instead of buying too deep into one product line just to fill a container, buyers can build a healthier stock mix across fast-moving and supporting items that fit real market demand.",
    image: "/images/homepage/homepage-turnover.webp",
    bullets: [
      "Less pressure to overstock slow-moving SKUs",
      "Stronger inventory structure with the same budget",
      "Better cash-flow efficiency and repeat-order potential",
    ],
    href: "/sourcing",
  },
];

const storyPanels = [
  {
    kicker: "Supplier fit",
    title: "Start with the right supplier set.",
    desc: "Category scope, response quality, MOQ, lead time, and execution risk are checked before buyers compare prices.",
    image: "/images/homepage/homepage-supplier-fit.webp",
  },
  {
    kicker: "Part confirmation",
    title: "Clarify the part before quoting.",
    desc: "OE references, VIN or chassis details, dimensions, samples, photos, and platform notes reduce wrong-item risk.",
    image: "/images/homepage/homepage-part-confirmation.webp",
  },
  {
    kicker: "QC and packing",
    title: "Control the details buyers remember.",
    desc: "Sampling, carton labels, packing standards, document review, and pre-shipment checks keep execution visible.",
    image: "/images/homepage/homepage-qc-packing.webp",
  },
  {
    kicker: "Shipment planning",
    title: "Build the container around real demand.",
    desc: "Multi-supplier consolidation protects freight efficiency without forcing buyers to overstock one narrow product line.",
    image: "/images/homepage/homepage-shipment-planning.webp",
  },
];

const insightImages = [
  "/images/homepage/homepage-landed-cost.webp",
  "/images/homepage/homepage-part-confirmation.webp",
  "/images/homepage/homepage-qc-packing.webp",
];

insights.forEach((item, index) => {
  item.image = insightImages[index % insightImages.length];
});

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://certispares.com/#webpage",
    name: "Commercial Vehicle Parts Sourcing from China",
    description:
      "CertiSpares helps commercial vehicle aftermarket buyers source from China through multi-supplier consolidation, lower landed cost, and more balanced inventory planning.",
    url: "https://certispares.com/",
    isPartOf: {
      "@id": "https://certispares.com/#website",
    },
    about: {
      "@id": "https://certispares.com/#organization",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://certispares.com/#commercial-vehicle-parts-sourcing-service",
    serviceType: "Commercial vehicle parts sourcing support from China",
    provider: {
      "@id": "https://certispares.com/#organization",
    },
    areaServed: "Worldwide",
    audience: {
      "@type": "BusinessAudience",
      audienceType: "Importers, distributors, wholesalers, fleet-related buyers, and aftermarket parts buyers",
    },
    description:
      "RFQ-first sourcing support covering RFQ clarification, supplier comparison, QC checkpoint coordination, packing and document follow-up, and multi-supplier shipment consolidation.",
  },
];
---

<BaseLayout
  title="Commercial Vehicle Parts Sourcing from China | CertiSpares"
  description="CertiSpares supports overseas buyers with China truck parts RFQs, supplier comparison, QC checkpoints, packing, documents, and multi-supplier shipment consolidation."
  keywords={["commercial vehicle parts sourcing China", "heavy duty truck parts", "commercial vehicle aftermarket", "RFQ sourcing", "truck parts from China"]}
  canonical="/"
  ogImage="/images/hero-01-highway-transport.webp"
  jsonLd={jsonLd}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroImage.src}
    type="image/webp"
    fetchpriority="high"
  />

  <style>
  :root{
    --bg:#F7F9FC;
    --text:#1d2a36;
    --muted:#667085;
    --line:#DFE6E9;
    --brand:#0A2540;
    --brand2:#3957E9;
  }

  :global(main){
    background:
      linear-gradient(180deg, #f5f8fc 0%, #eef3f7 100%);
  }

  .hero{
    position:relative;
    border-bottom:1px solid var(--line);
    overflow:hidden;
    isolation:isolate;
  }

  .heroBg{
    position:absolute; inset:0;
    background:
      linear-gradient(180deg, rgba(11,16,32,.45) 0%, rgba(11,16,32,.86) 70%, rgba(11,16,32,1) 100%),
      radial-gradient(900px 420px at 25% 15%, rgba(57,87,233,.35), transparent 60%);
    overflow:hidden;
  }

  .heroBgImage{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    object-position:70% center;
    filter:saturate(1.03) contrast(1.04) brightness(.88);
  }

  .heroBg::after{
    content:"";
    position:absolute;
    inset:0;
    background:
      radial-gradient(900px 420px at 23% 18%, rgba(57,87,233,.24), transparent 62%),
      radial-gradient(680px 360px at 56% 50%, rgba(255,255,255,.04), transparent 72%),
      linear-gradient(90deg, rgba(5,12,26,.94) 0%, rgba(5,12,26,.82) 24%, rgba(5,12,26,.28) 52%, rgba(5,12,26,.48) 74%, rgba(5,12,26,.88) 100%),
      linear-gradient(180deg, rgba(5,12,26,.14) 0%, rgba(5,12,26,.58) 78%, rgba(5,12,26,.96) 100%);
  }

  .heroSlider{
    position:absolute; inset:0;
  }

  .heroSlide{
    position:absolute; inset:0;
    overflow:hidden;
    filter:saturate(1.05);
    opacity:0;
    transform:scale(1.02);
    transition: opacity .55s ease, transform .9s ease;
    will-change: opacity, transform;
  }

  .heroSlide.is-active{
    opacity:1;
    transform:scale(1);
  }

  .heroSlide img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
  }

  .heroSlide::after{
    content:"";
    position:absolute; inset:0;
    background:
      radial-gradient(1100px 520px at 28% 18%, rgba(255,255,255,.06), transparent 60%),
      radial-gradient(1400px 760px at 50% 50%, transparent 55%, rgba(11,16,32,.55) 100%),
      linear-gradient(
        180deg,
        rgba(11,16,32,.18) 0%,
        rgba(11,16,32,.72) 70%,
        rgba(11,16,32,.92) 100%
      );
  }

  .heroNav{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:42px; height:42px;
    border-radius:14px;
    border:1px solid var(--line);
    background:rgba(17,26,51,.45);
    color:rgba(234,240,255,.92);
    font-size:26px;
    display:grid; place-items:center;
    cursor:pointer;
    z-index:2;
    backdrop-filter: blur(10px);
    user-select:none;
  }

  .heroNav:hover{ background:rgba(17,26,51,.65); }

  .heroNav.prev{ left:16px; }

  .heroNav.next{ right:16px; }

  .heroInner{
    position:relative;
    width:min(1760px, calc(100vw - 64px));
    margin:0 auto;
    padding:74px 0 54px;
    display:grid;
    grid-template-columns:minmax(480px, 650px) minmax(300px, 360px);
    justify-content:space-between;
    gap:clamp(220px, 25vw, 520px);
    align-items:center;
  }

  .homeHero .container{
    width:100%;
    max-width:none;
  }

  .heroCopy{
    position:relative;
    z-index:2;
  }

  h1{
    margin:0 0 14px;
    font-size:52px;
    line-height:1.03;
    letter-spacing:-.6px;
    color:#fff;
  }

  h1 span{
    color:#2f6bff;
  }

  .sub{
    margin:0 0 18px;
    color:rgba(234,240,255,.86);
    line-height:1.75;
    max-width:640px;
  }

  .heroBtns{ display:flex; gap:12px; flex-wrap:wrap; margin-top:16px; }

  .heroBtns .btn:not(.primary){
    color:#fff;
    background:rgba(255,255,255,.08);
    border-color:rgba(255,255,255,.22);
  }

  .heroCard{
    justify-self:end;
    width:min(360px, 100%);
    background:rgba(7,18,38,.74);
    border:1px solid rgba(255,255,255,.14);
    border-left:3px solid rgba(255,255,255,.72);
    border-radius:8px;
    padding:22px;
    box-shadow:0 18px 42px rgba(0,0,0,.28);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
  }

  .heroCard h3{ margin:0 0 10px; font-size:16px; letter-spacing:.2px; color:#fff; }

  .list{ margin:0; padding:0; list-style:none; display:grid; gap:10px; }

  .li{ display:flex; gap:10px; align-items:flex-start; color:rgba(255,255,255,.92); line-height:1.5; }

  .dot{
    width:18px;
    height:18px;
    border-radius:999px;
    margin-top:2px;
    background:#2365ff;
    flex:0 0 18px;
    display:inline-grid;
    place-items:center;
    box-shadow:0 0 0 4px rgba(35,101,255,.14);
  }

  .dot::after{
    content:"";
    width:7px;
    height:4px;
    border-left:2px solid #fff;
    border-bottom:2px solid #fff;
    transform:rotate(-45deg) translateY(-1px);
  }

  .more{ display:inline-block; margin-top:10px; font-weight:900; color:var(--brand); }

  .heroCard .more{ color:rgba(255,255,255,.92); }

  .more:hover{ color:var(--brand2); }

  .grid3{ display:grid; grid-template-columns: repeat(3, 1fr); gap:14px; }

  .grid2{ display:grid; grid-template-columns: repeat(2, 1fr); gap:14px; }

  .flowGrid{
    display:grid;
    grid-template-columns:repeat(5, minmax(0, 1fr));
    gap:14px;
    position:relative;
  }

  .flowCard{
    padding:22px;
    display:grid;
    gap:12px;
    align-content:start;
    border-left:0;
    text-align:center;
  }

  .flowStep{
    width:50px;
    height:50px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    justify-self:center;
    border-radius:999px;
    background:#2365ff;
    color:#fff;
    font-size:13px;
    font-family:"Work Sans", Arial, sans-serif;
    font-weight:800;
    box-shadow:0 12px 24px rgba(35,101,255,.20);
  }

  .flowCard small{
    color:#2365ff;
    font-size:12px;
    font-weight:900;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .flowCard b{
    display:block;
    font-size:16px;
    line-height:1.32;
  }

  .flowCard p{
    margin:0;
    line-height:1.62;
    font-size:14px;
  }

  .sectionTitle{ font-size:30px; margin:0 0 12px; letter-spacing:-.025em; color:#1d2a36; }

  .sectionDesc{ margin:0 0 18px; color:var(--muted); line-height:1.7; max-width:980px; }

  .sectionHead{
    display:flex;
    align-items:baseline;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:12px;
  }

  .sectionHead .sectionTitle{
    margin:0;
  }

  .sectionJump{
    color:var(--brand);
    font-size:14px;
    font-weight:800;
    text-decoration:none;
    white-space:nowrap;
  }

  .sectionJump:hover{
    text-decoration:underline;
    text-underline-offset:3px;
  }

  .strip{
    margin-top:18px;
    width:min(980px, calc(100vw - 96px));
    display:grid;
    grid-template-columns: repeat(4,1fr);
    gap:12px;
  }

  .kpi{
    display:flex;
    align-items:flex-start;
    gap:11px;
    background:rgba(255,255,255,.045);
    border:1px solid var(--line);
    border-radius:8px;
    padding:14px;
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
  }

  .kpi .icon{
    width:30px;
    height:30px;
    flex:0 0 30px;
    display:inline-grid;
    place-items:center;
    border-radius:8px;
    background:#2365ff;
    color:#fff;
    font-size:12px;
    font-weight:900;
    box-shadow:0 8px 18px rgba(35,101,255,.22);
  }

  .kpi .n{ font-weight:950; font-size:14px; color:#fff; line-height:1.2; }

  .kpi .t{ color:rgba(255,255,255,.88); font-size:12px; margin-top:6px; line-height:1.4; }

  .insightsHead{
    display:flex; align-items:flex-end; justify-content:space-between; gap:12px;
    margin-bottom:12px;
  }

  .viewAll{
    font-weight:900;
    color:#1d2a36;
    padding:8px 10px;
    border-radius:8px;
    border:1px solid rgba(29,42,54,.10);
    background:#fff;
    white-space:nowrap;
  }

  .viewAll:hover{ background:#f3f6fa; color:#1d2a36; }

  .postCard b{ margin-bottom:8px; font-size:16px; line-height:1.35; }

  .insightsGrid{
    display:grid;
    grid-template-columns:repeat(3, minmax(0, 1fr)) minmax(300px, .95fr);
    gap:14px;
    align-items:stretch;
  }

  .postCard{
    overflow:hidden;
    padding:0;
  }

  .postCard .postMeta,
  .postCard b,
  .postCard p,
  .postCard .postMore{
    margin-left:18px;
    margin-right:18px;
  }

  .postCard .postMore{
    margin-bottom:18px;
  }

  .postImage{
    display:block;
    min-height:118px;
    margin:0 0 16px;
    background-size:cover;
    background-position:center;
    position:relative;
  }

  .postImage::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(180deg, rgba(8,14,30,.04), rgba(8,14,30,.28));
  }

  .rfqPanel{
    position:relative;
    overflow:hidden;
    border-radius:8px;
    padding:28px;
    min-height:100%;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    justify-content:center;
    color:#fff;
    background:#071226;
    box-shadow:0 18px 42px rgba(10,37,64,.16);
  }

  .rfqPanel::before{
    content:"";
    position:absolute;
    inset:0;
    background:
      linear-gradient(90deg, rgba(7,18,38,.95), rgba(7,18,38,.76)),
      url("/images/homepage/homepage-cta-port.webp") center/cover;
    transform:scale(1.02);
  }

  .rfqPanel h3,
  .rfqPanel p,
  .rfqPanel a{
    position:relative;
    z-index:1;
  }

  .rfqPanel h3{
    margin:0 0 12px;
    color:#fff;
    font-size:27px;
    line-height:1.08;
  }

  .rfqPanel p{
    margin:0 0 18px;
    color:rgba(234,240,255,.84);
    line-height:1.65;
  }

  .postMeta{
    display:flex; gap:10px; flex-wrap:wrap; align-items:center;
    font-size:12px; color:#6d7b91;
    margin-bottom:10px;
  }

  .postTag{
    padding:.18rem .55rem;
    border-radius:8px;
    border:1px solid rgba(74,84,98,.16);
    background:rgba(74,84,98,.08);
    font-weight:800;
    color:#4A5462;
  }

  .postMore{
    display:inline-flex; gap:6px; align-items:center;
    margin-top:10px; font-weight:900;
    color:#4A5462;
  }

  .btn.primary{
    color:#fff;
  }

  .btn.whatsappBtn{
    background:#18b66a;
    border-color:#18b66a;
    color:#fff;
    box-shadow:0 10px 24px rgba(24,182,106,.22);
  }

  .btn.whatsappBtn:hover{
    background:#11985a;
    border-color:#11985a;
  }

  .card{
    background:#fff;
    border:1px solid rgba(29,42,54,.10);
    box-shadow:0 8px 20px rgba(10,37,64,.04);
  }

  .card b{
    color:#1d2a36;
  }

  .card p{
    color:#5f6d86;
  }

  .strategyGrid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:14px;
  }

  .strategyCard{
    display:flex;
    flex-direction:column;
    gap:14px;
    overflow:hidden;
    padding:0;
  }

  .strategyMedia{
    position:relative;
    min-height:132px;
    max-height:150px;
    overflow:hidden;
    background:#0b1020;
  }

  .strategyMedia img{
    width:100%;
    height:100%;
    min-height:132px;
    max-height:150px;
    object-fit:cover;
    display:block;
    filter:saturate(1.02) contrast(1.02);
  }

  .strategyMedia::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(180deg, rgba(8,14,30,.04), rgba(8,14,30,.40));
  }

  .strategyBody{
    padding:18px;
    display:grid;
    gap:14px;
  }

  .strategyCard p{
    margin:0;
  }

  .strategyList{
    margin:0;
    padding:0;
    list-style:none;
    display:grid;
    gap:10px;
  }

  .strategyItem{
    display:flex;
    gap:10px;
    align-items:flex-start;
    color:#5f6d86;
    line-height:1.6;
  }

  .strategyDot{
    width:10px;
    height:10px;
    border-radius:999px;
    margin-top:7px;
    background:#4A5462;
    flex:0 0 10px;
  }

  .productBand{
    position:relative;
    overflow:hidden;
    border-radius:8px;
    border:1px solid rgba(29,42,54,.10);
    background:#fff;
    box-shadow:0 8px 20px rgba(10,37,64,.04);
    padding:18px 0;
  }

  .productBand::before,
  .productBand::after{
    content:"";
    position:absolute;
    top:0;
    bottom:0;
    width:92px;
    z-index:2;
    pointer-events:none;
  }

  .productBand::before{
    left:0;
    background:linear-gradient(90deg, rgba(246,249,253,1) 0%, rgba(246,249,253,0) 100%);
  }

  .productBand::after{
    right:0;
    background:linear-gradient(270deg, rgba(246,249,253,1) 0%, rgba(246,249,253,0) 100%);
  }

  .logoMarquee{
    overflow:hidden;
    white-space:nowrap;
  }

  .logoTrack{
    display:flex;
    width:max-content;
    align-items:center;
    gap:14px;
    animation:marqueeRight 36s linear infinite;
    will-change:transform;
  }

  .logoCard{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:center;
    min-width:164px;
    width:164px;
    height:104px;
    padding:10px;
    border-radius:8px;
    background:linear-gradient(180deg, #ffffff 0%, #f6f9fc 100%);
    border:1px solid rgba(29,42,54,.08);
    box-shadow:0 10px 24px rgba(24,39,56,.06);
    position:relative;
    overflow:hidden;
  }

  .logoCard::before{
    content:"";
    position:absolute;
    inset:0;
    background:
      linear-gradient(120deg, transparent 0%, rgba(57,87,233,.08) 35%, transparent 65%),
      radial-gradient(180px 60px at 50% -10%, rgba(57,87,233,.10), transparent 70%);
    transform:translateX(-140%);
    animation:logoShimmer 3.6s ease-in-out infinite;
    pointer-events:none;
  }

  .logoInner{
    position:relative;
    z-index:1;
    width:100%;
    height:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:8px;
    background:rgba(255,255,255,.72);
    backdrop-filter:blur(4px);
  }

  .logoCard img{
    max-width:132px;
    max-height:66px;
    width:auto;
    height:auto;
    object-fit:contain;
    display:block;
    filter:saturate(.92) contrast(1.04);
  }

  .storyGrid{
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:14px;
  }

  .storyPanel{
    position:relative;
    min-height:260px;
    max-height:300px;
    display:flex;
    align-items:flex-end;
    overflow:hidden;
    border-radius:var(--radius-card);
    border:1px solid rgba(29,42,54,.10);
    background:#0b1020;
    box-shadow:0 8px 24px rgba(10,37,64,.08);
  }

  .storyPanel img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    filter:saturate(1.04) contrast(1.02);
    transform:scale(1.02);
  }

  .storyPanel::after{
    content:"";
    position:absolute;
    inset:0;
    background:
      linear-gradient(180deg, rgba(8,14,30,.08) 0%, rgba(8,14,30,.58) 54%, rgba(8,14,30,.92) 100%),
      radial-gradient(760px 320px at 18% 20%, rgba(57,87,233,.20), transparent 60%);
  }

  .storyCopy{
    position:relative;
    z-index:1;
    padding:18px;
    max-width:560px;
  }

  .storyKicker{
    display:inline-flex;
    margin:0 0 10px;
    padding:6px 10px;
    border-radius:8px;
    border:1px solid rgba(255,255,255,.16);
    background:rgba(17,26,51,.52);
    color:rgba(255,255,255,.92);
    font-size:12px;
    font-weight:900;
    letter-spacing:.06em;
    text-transform:uppercase;
  }

  .storyCopy h3{
    margin:0 0 10px;
    color:#fff;
    font-size:20px;
    line-height:1.18;
    letter-spacing:-.2px;
  }

  .storyCopy p{
    margin:0;
    color:rgba(234,240,255,.84);
    line-height:1.6;
    font-size:14px;
  }

  @keyframes marqueeRight{
    from{ transform:translateX(-50%); }
    to{ transform:translateX(0); }
  }

  @keyframes logoShimmer{
    0%, 18%{ transform:translateX(-140%); }
    42%, 100%{ transform:translateX(140%); }
  }

  .heroCopy,
  .heroCard,
  .productBand,
  .storyPanel,
  .strategyCard,
  .flowCard,
  .postCard,
  .rfqPanel{
    animation:homeRise .64s ease both;
  }

  .heroCard{ animation-delay:.10s; }
  .productBand{ animation-delay:.08s; }
  .storyPanel:nth-child(2),
  .strategyCard:nth-child(2),
  .flowCard:nth-child(2),
  .postCard:nth-child(2){ animation-delay:.06s; }
  .storyPanel:nth-child(3),
  .flowCard:nth-child(3),
  .postCard:nth-child(3){ animation-delay:.12s; }
  .storyPanel:nth-child(4),
  .flowCard:nth-child(4){ animation-delay:.18s; }
  .flowCard:nth-child(5),
  .rfqPanel{ animation-delay:.24s; }

  @keyframes homeRise{
    from{ opacity:0; transform:translateY(18px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .postMore:hover{ color:#4A5462; }

  @media (max-width: 980px){
    .heroInner{
      width:min(calc(100% - 32px), var(--container-default));
      grid-template-columns:1fr;
      gap:18px;
      padding:60px 0 46px;
    }
    h1{ font-size:40px; }

  .grid3{ grid-template-columns:1fr; }

  .grid2{ grid-template-columns:1fr; }


  .flowGrid{ grid-template-columns:1fr; }

  .insightsGrid{ grid-template-columns:1fr; }

  .strategyGrid{ grid-template-columns:1fr; }

  .storyGrid{ grid-template-columns:1fr; }

  .storyPanel{
    min-height:230px;
    max-height:none;
  }

  .strategyMedia,
  .strategyMedia img{
    min-height:120px;
    max-height:130px;
  }

  .strip{
    width:100%;
    grid-template-columns:1fr 1fr;
  }

  .insightsHead{ align-items:flex-start; }

  .heroNav{ width:38px; height:38px; border-radius:12px; }

  .heroNav.prev{ left:10px; }

  .heroNav.next{ right:10px; }
  }

  @media (prefers-reduced-motion: reduce){
    .heroSlide{ transition:none; }

    .heroCopy,
    .heroCard,
    .productBand,
    .storyPanel,
    .strategyCard,
    .flowCard,
    .postCard,
    .rfqPanel{
      animation:none !important;
    }

  .logoTrack{ animation:none; }
  }
  </style>

  <header class="hero homeHero">
      <div class="heroBg">
        <img
          class="heroBgImage"
          src={heroImage.src}
          alt=""
          width={heroImage.width}
          height={heroImage.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
    </div>

    <div class="container">
      <div class="heroInner">
        <div class="heroCopy">
          <h1>Commercial Vehicle Parts Sourcing from China, <span>Simplified.</span></h1>
          <p class="sub">
            CertiSpares helps aftermarket buyers source commercial vehicle parts from China through supplier comparison, QC checkpoints, and multi-supplier container consolidation.
          </p>

          <div class="heroBtns">
            <a class="btn primary whatsappBtn" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Send OE / VIN / Photos on WhatsApp</a>
            <a class="btn" href="/capabilities">View Capabilities</a>
          </div>

          <div class="strip">
            <div class="kpi"><div class="icon">C</div><div><div class="n">Cost Advantage</div><div class="t">Multi-supplier consolidation to reduce landed cost.</div></div></div>
            <div class="kpi"><div class="icon">M</div><div><div class="n">Wide Selection</div><div class="t">Truck, trailer, bus, and light commercial vehicle parts.</div></div></div>
            <div class="kpi"><div class="icon">Q</div><div><div class="n">Quality Assurance</div><div class="t">Sampling, packing checks, and loading supervision.</div></div></div>
            <div class="kpi"><div class="icon">D</div><div><div class="n">Reliable Delivery</div><div class="t">Shipment coordination across suppliers and SKUs.</div></div></div>
          </div>
        </div>

        <aside class="heroCard">
          <h3>Why Buyers Choose CertiSpares</h3>
          <ul class="list">
            <li class="li"><span class="dot"></span><span>One-to-one RFQ support from inquiry to shipment.</span></li>
            <li class="li"><span class="dot"></span><span>Supplier comparison across verified China networks.</span></li>
            <li class="li"><span class="dot"></span><span>Mixed SKU and multi-supplier container consolidation.</span></li>
            <li class="li"><span class="dot"></span><span>QC checkpoints, packing checks, and loading coordination.</span></li>
            <li class="li"><span class="dot"></span><span>Clear communication before price, production, and delivery.</span></li>
          </ul>
          <a class="more" href="/sourcing">View Sourcing Strategy &rarr;</a>
        </aside>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <h2 class="sectionTitle">Brands and Platforms We Support</h2>
      <div class="productBand" aria-label="Commercial vehicle brands we support">
        <div class="logoMarquee">
          <div class="logoTrack">
            {[...productBrands, ...productBrands].map((brand, index) => (
              <div class="logoCard" aria-hidden={index >= productBrands.length ? "true" : "false"}>
                <div class="logoInner">
                  <img src={brand.image} alt={brand.alt} loading="lazy" decoding="async" />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sectionHead">
        <h2 class="sectionTitle">What We Check Before a Quote Becomes Useful</h2>
        <a class="sectionJump" href="/capabilities">View Capabilities &rarr;</a>
      </div>
      <div class="storyGrid">
        {storyPanels.map((panel) => (
          <article class="storyPanel">
            <img src={panel.image} alt="" loading="lazy" decoding="async" />
            <div class="storyCopy">
              <p class="storyKicker">{panel.kicker}</p>
              <h3>{panel.title}</h3>
              <p>{panel.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sectionHead">
        <h2 class="sectionTitle">How You Save Cost and Improve Turnover</h2>
        <a class="sectionJump" href="/blog/how-container-consolidation-improves-cost-and-inventory-turnover">Detailed explanation &rarr;</a>
      </div>
      <div class="strategyGrid">
        {strategyCards.map((item) => (
          <div class="card strategyCard">
            <div class="strategyMedia">
              <img src={item.image} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="strategyBody">
              <div>
                <b>{item.title}</b>
                <p>{item.desc}</p>
              </div>
              <ul class="strategyList">
                {item.bullets.map((bullet) => (
                  <li class="strategyItem"><span class="strategyDot"></span><span>{bullet}</span></li>
                ))}
              </ul>
              <a class="more" href={item.href}>View Sourcing Strategy &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sectionHead">
        <h2 class="sectionTitle">How It Works</h2>
        <a class="sectionJump" href="/how-it-works">See full workflow &rarr;</a>
      </div>
      <div class="flowGrid">
        {rfqFlowCards.map((item, index) => (
          <article class="card flowCard">
            <span class="flowStep">{index + 1}</span>
            <small>{item.step}</small>
            <b>{item.title}</b>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="insightsHead">
        <div>
          <h2 class="sectionTitle">Latest Insights</h2>
        </div>
        <a class="viewAll" href="/blog">View all &rarr;</a>
      </div>

      <div class="insightsGrid">
        {insights.map((p) => (
          <a class="card postCard" href={p.href}>
            <span class="postImage" style={`background-image:url('${p.image}')`}></span>
            <div class="postMeta">
              <span class="postTag">{p.tag}</span>
            </div>
            <b>{p.title}</b>
            <p>{p.excerpt}</p>
            <span class="postMore">Read &rarr;</span>
          </a>
        ))}
        <aside class="rfqPanel">
          <h3>Ready to Source Smarter?</h3>
          <p>
            Send your RFQ with OE numbers, photos, quantities, or vehicle details. We will help clarify the part, compare supplier options, and suggest a practical shipment plan.
          </p>
          <a class="btn secondary" href="/contact">Send Your RFQ Now &rarr;</a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
