---
import BaseLayout from "../layouts/BaseLayout.astro";

const controlItems = [
  {
    title: "RFQ Scope",
    text: "Clarify part details, fitment and demand",
  },
  {
    title: "Supplier Comparison",
    text: "Compare based on the same scope",
  },
  {
    title: "Packing Notes",
    text: "Packing, labels and carton marks",
  },
  {
    title: "QC Checkpoints",
    text: "Inspection points and photo evidence",
  },
  {
    title: "Documents",
    text: "PI, CI, PL, COO and other documents",
  },
  {
    title: "Shipment Follow-up",
    text: "Container, tracking and after-sales follow-up",
  },
];

const existCards = [
  {
    title: "Commercial Vehicle Aftermarket Focus",
    text: "Built around truck parts RFQs where fitment clarity, repeat orders, and execution discipline matter.",
    icon: "target",
  },
  {
    title: "Northern China Sourcing Relevance",
    text: "Connected to supplier clusters and supporting supply chains for heavy-duty and commercial vehicle parts.",
    icon: "pin",
  },
  {
    title: "Structured Sourcing & Risk Control",
    text: "RFQs are reviewed through matching scope, supplier comparison, QC checkpoints, documents, and shipment execution.",
    icon: "shield",
  },
];

const practiceCards = [
  {
    title: "A sourcing operator, not a factory profile",
    text: "Production stays with matched suppliers. CertiSpares coordinates RFQ clarification, supplier selection, QC checkpoints, documents, and shipment follow-up.",
  },
  {
    title: "Best fit: a real parts list",
    text: "The model works best when buyers send OE numbers, old supplier sheets, photos, mixed SKUs, or repeat-order demand that needs sorting.",
  },
  {
    title: "Repeatable supply, not one cheap quote",
    text: "A low price only matters when the part is right, packing is acceptable, lead time is realistic, and the path can be repeated.",
  },
];

const marketPoints = [
  {
    title: "Heavy-duty depth",
    text: "Stronger supplier familiarity in heavy-duty systems and China truck platforms.",
  },
  {
    title: "Light & medium-duty support",
    text: "Supported when the RFQ scope, part details, and supplier fit are clear.",
  },
  {
    title: "Mixed aftermarket demand",
    text: "Useful for buyers managing replenishment across brake, chassis, cooling, rubber, electrical, and related systems.",
  },
];

const workSteps = [
  {
    title: "Clarify the RFQ",
    text: "OE numbers, photos, VIN/model, supplier notes, and buyer lists are organized before quotation.",
  },
  {
    title: "Compare Suppliers",
    text: "Supplier options are checked by fit, MOQ, lead time, price level, packing, and execution feasibility.",
  },
  {
    title: "Control Checkpoints",
    text: "Packing, labels, QC evidence, documents, and shipment preparation are followed before dispatch.",
  },
  {
    title: "Make It Repeatable",
    text: "A proven sourcing path becomes easier to repeat, standardize, and expand for future orders.",
  },
];

const founderCards = [
  {
    title: "Review before assumption",
    text: "Do not push a quote forward before the matching scope is reasonably clear.",
  },
  {
    title: "Compare on the same basis",
    text: "Supplier comparison only matters when item scope, packing, MOQ, lead time, and documents are comparable.",
  },
  {
    title: "Control the visible checkpoints",
    text: "Packing, labels, photos, documents, and shipment status should be checked before problems become disputes.",
  },
];

const supportCards = [
  {
    title: "Brake System",
    text: "Brake chamber, drums, linings, valves, repair kits, and related components.",
    image: "/images/insights/insights-article-brake-chamber-rfq.webp",
  },
  {
    title: "Chassis & Suspension",
    text: "Torque rods, bushings, stabilizer parts, hub-related parts, bearings, and suspension hardware.",
    image: "/images/assemblies/assembly-suspension.webp",
  },
  {
    title: "Steering / Drivetrain",
    text: "Selected steering and drivetrain-related aftermarket parts based on RFQ scope.",
    image: "/images/assemblies/assembly-axle.webp",
  },
  {
    title: "Electrical / Body / Mixed SKUs",
    text: "Lights, mirrors, wiring consumables, selected body parts, and mixed replenishment items.",
    image: "/images/insights/insights-topic-aftermarket-replenishment.webp",
  },
];

const buyerCards = [
  {
    title: "Distributors",
    text: "Need stable supply and cleaner repeat-order execution.",
  },
  {
    title: "Aftermarket Wholesalers",
    text: "Manage mixed categories and multi-supplier replenishment.",
  },
  {
    title: "Fleet-related Buyers",
    text: "Care about fitment clarity, delivery predictability, and fewer disputes.",
  },
  {
    title: "Growth-stage Importers",
    text: "Need sourcing structure before building a larger China supplier base.",
  },
];

const principles = [
  {
    title: "Clarity",
    text: "Clear inputs lead to clearer execution.",
  },
  {
    title: "Evidence",
    text: "QC evidence before shipment reduces avoidable disputes.",
  },
  {
    title: "Trace",
    text: "PI, CI, PL, labels, and carton marks should stay consistent.",
  },
  {
    title: "Repeat",
    text: "A stable path should become easier to repeat and expand.",
  },
];

const ctaSteps = [
  "RFQ Input",
  "Matching Scope",
  "Supplier Comparison",
  "Quotation",
  "QC & Shipment Follow-up",
];

const faqs = [
  {
    q: "Do you need OEM / part numbers?",
    a: "OE or part numbers are useful, but they are not the only way to start. Photos, dimensions, VIN or model references, old supplier sheets, and packaging notes can also help clarify the RFQ scope.",
  },
  {
    q: "Can you support mixed-SKU orders?",
    a: "Yes. Mixed-SKU aftermarket RFQs are often a good fit because they need supplier comparison, consolidation thinking, packing control, and repeat-order structure.",
  },
  {
    q: "Do you only work with one supplier?",
    a: "No. Supplier options depend on the RFQ scope, category, quantity, lead time, packing needs, and execution feasibility. The goal is to compare on a clear basis.",
  },
  {
    q: "What kind of buyers do you usually support?",
    a: "CertiSpares is built for importers, distributors, wholesalers, and fleet-related buyers who need commercial vehicle aftermarket RFQs clarified before sourcing moves forward.",
  },
];

const iconPath = {
  target: ["M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z", "M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10z", "M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z", "M18 6l3-3"],
  pin: ["M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z", "M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"],
  shield: ["M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z", "M9 11l2 2 4-4"],
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About CertiSpares",
    description:
      "CertiSpares is a focused sourcing operator for commercial vehicle aftermarket RFQs that need sorting, clarification, supplier comparison, QC checkpoints, and controlled execution.",
    url: "https://certispares.com/about/",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://certispares.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "About",
        item: "https://certispares.com/about/",
      },
    ],
  },
];
---

<BaseLayout
  title="About CertiSpares | Commercial Vehicle RFQ Sourcing Operator"
  description="About CertiSpares, a focused sourcing operator for commercial vehicle aftermarket RFQs that need sorting, supplier comparison, QC checkpoints, documents, and shipment follow-up."
  keywords={["commercial vehicle RFQ sourcing", "truck parts sourcing operator", "commercial vehicle aftermarket China", "supplier comparison truck parts", "RFQ clarification"]}
  canonical="/about/"
  ogImage="/images/insights/insights-hero-sourcing-yard.webp"
  jsonLd={jsonLd}
>
  <style>
    :root{
      --about-bg:#f4f7fb;
      --about-ink:#111f43;
      --about-text:#28364f;
      --about-muted:#66738c;
      --about-line:rgba(17,31,67,.10);
      --about-blue:#2365ff;
      --about-navy:#071f43;
      --about-soft:#edf4ff;
    }

    :global(main){
      background:var(--about-bg);
      color:var(--about-text);
    }

    .aboutHero{
      position:relative;
      overflow:hidden;
      isolation:isolate;
      background:#071226;
      color:#fff;
    }

    .aboutHero::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-2;
      background:url("/images/insights/insights-hero-sourcing-yard.webp") center/cover no-repeat;
      filter:saturate(.95) contrast(1.02) brightness(.70);
      transform:scale(1.02);
    }

    .aboutHero::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:-1;
      background:
        linear-gradient(90deg, rgba(7,18,38,.96) 0%, rgba(7,18,38,.82) 43%, rgba(7,18,38,.52) 74%, rgba(7,18,38,.78) 100%),
        linear-gradient(180deg, rgba(7,18,38,.20) 0%, rgba(7,18,38,.90) 100%);
    }

    .heroInner{
      display:grid;
      grid-template-columns:minmax(0, 1fr) minmax(330px, 410px);
      gap:48px;
      align-items:center;
      min-height:510px;
      padding:58px 0 38px;
    }

    .eyebrow{
      margin:0 0 14px;
      color:#6fa0ff;
      font-size:13px;
      font-weight:900;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .heroCopy h1{
      margin:0;
      max-width:780px;
      color:#fff;
      font-size:clamp(40px, 4.6vw, 58px);
      line-height:1.04;
      letter-spacing:0;
    }

    .heroCopy p{
      margin:22px 0 0;
      max-width:720px;
      color:rgba(234,240,255,.88);
      font-size:18px;
      line-height:1.72;
    }

    .heroActions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:30px;
    }

    .actionBtn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-height:48px;
      padding:0 22px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.24);
      color:#fff;
      font-size:14px;
      font-weight:900;
      transition:transform .16s ease, background .16s ease, border-color .16s ease;
    }

    .actionBtn.primary{
      border-color:#2365ff;
      background:#2365ff;
      box-shadow:0 16px 34px rgba(35,101,255,.22);
    }

    .actionBtn:hover{
      transform:translateY(-2px);
      border-color:rgba(255,255,255,.42);
      background:rgba(255,255,255,.08);
    }

    .controlPanel{
      padding:22px;
      border:1px solid rgba(255,255,255,.18);
      border-radius:8px;
      background:rgba(7,18,38,.74);
      box-shadow:0 24px 58px rgba(0,0,0,.30);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
    }

    .controlPanel h2{
      margin:0 0 15px;
      color:#fff;
      font-size:18px;
      letter-spacing:0;
    }

    .controlList{
      display:grid;
      gap:8px;
    }

    .controlItem{
      display:flex;
      align-items:center;
      gap:10px;
      min-height:42px;
      padding:9px 10px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.08);
      color:rgba(234,240,255,.92);
      font-size:13px;
      font-weight:850;
    }

    .controlItem strong{
      display:block;
      color:#fff;
      font-size:13px;
      line-height:1.2;
    }

    .controlItem small{
      display:block;
      margin-top:3px;
      color:rgba(234,240,255,.68);
      font-size:11px;
      font-weight:700;
      line-height:1.35;
    }

    .controlIcon,
    .cardIcon,
    .principleIcon{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:8px;
      border:1px solid rgba(111,160,255,.42);
      color:#6fa0ff;
      flex:0 0 auto;
    }

    .controlIcon{
      width:28px;
      height:28px;
    }

    .controlIcon::before{
      content:"";
      width:8px;
      height:8px;
      border-radius:2px;
      border:1.5px solid currentColor;
    }

    .pageBody{
      padding:20px 0 0;
    }

    .sectionBlock{
      padding:24px 0;
    }

    .sectionHeader{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:22px;
      margin-bottom:18px;
    }

    .sectionHeader h2{
      margin:0;
      color:var(--about-ink);
      font-size:28px;
      line-height:1.18;
      letter-spacing:0;
    }

    .sectionHeader p{
      margin:7px 0 0;
      max-width:760px;
      color:var(--about-muted);
      line-height:1.65;
    }

    .grid3,
    .supportGrid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:18px;
    }

    .grid4{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:14px;
    }

    .infoCard,
    .statementCard,
    .buyerCard{
      border:1px solid var(--about-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .infoCard{
      padding:24px;
    }

    .cardIcon{
      width:46px;
      height:46px;
      margin-bottom:16px;
      color:#2365ff;
      background:#f7faff;
    }

    .cardIcon svg{
      width:25px;
      height:25px;
      display:block;
      fill:none;
      stroke:currentColor;
      stroke-width:1.8;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .infoCard h3,
    .statementCard h3,
    .buyerCard h3{
      margin:0 0 10px;
      color:var(--about-ink);
      font-size:18px;
      line-height:1.25;
      letter-spacing:0;
    }

    .infoCard p,
    .statementCard p,
    .buyerCard p{
      margin:0;
      color:var(--about-muted);
      font-size:14px;
      line-height:1.65;
    }

    .statementCard{
      padding:24px;
      background:linear-gradient(180deg, #fff 0%, #edf4ff 100%);
    }

    .splitStage{
      display:grid;
      grid-template-columns:minmax(0, .98fr) minmax(0, 1.45fr);
      gap:34px;
      align-items:start;
    }

    .imagePanel{
      overflow:hidden;
      min-height:330px;
      border:1px solid var(--about-line);
      border-radius:8px;
      background:#dce5f0;
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .imagePanel img,
    .supportImage img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .focusPanel,
    .founderPanel{
      display:grid;
      grid-template-columns:minmax(0, .85fr) minmax(0, 1fr);
      gap:18px;
      align-items:stretch;
    }

    .marketPoints{
      display:grid;
      gap:12px;
      align-content:center;
    }

    .pointRow{
      display:grid;
      grid-template-columns:42px minmax(0, 1fr);
      gap:14px;
      align-items:flex-start;
      padding:10px 0;
    }

    .pointMark{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:42px;
      height:42px;
      border-radius:8px;
      border:1px solid rgba(35,101,255,.20);
      color:#2365ff;
      font-size:16px;
      font-weight:900;
      background:#f7faff;
    }

    .pointRow h3{
      margin:0 0 7px;
      color:var(--about-ink);
      font-size:17px;
      letter-spacing:0;
    }

    .pointRow p{
      margin:0;
      color:var(--about-muted);
      line-height:1.62;
    }

    .workPanel{
      min-width:0;
    }

    .workTrack{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:18px;
      position:relative;
      padding-top:8px;
    }

    .workStep{
      position:relative;
      padding-top:54px;
      min-width:0;
    }

    .workStep::before{
      content:"";
      position:absolute;
      top:18px;
      left:46px;
      right:-18px;
      height:1px;
      border-top:1px dashed rgba(35,101,255,.45);
    }

    .workStep:last-child::before{
      display:none;
    }

    .workNumber{
      position:absolute;
      top:0;
      left:0;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:38px;
      height:38px;
      border-radius:999px;
      background:#2365ff;
      color:#fff;
      font-size:13px;
      font-weight:950;
      box-shadow:0 12px 24px rgba(35,101,255,.18);
    }

    .workStep h3{
      margin:0 0 10px;
      color:var(--about-ink);
      font-size:16px;
      line-height:1.28;
      letter-spacing:0;
    }

    .workStep p{
      margin:0;
      color:var(--about-muted);
      font-size:13px;
      line-height:1.62;
    }

    .logicList{
      display:grid;
      gap:12px;
    }

    .logicItem{
      padding:17px 18px;
      border:1px solid var(--about-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 12px 28px rgba(17,31,67,.05);
    }

    .logicItem h3{
      margin:0 0 7px;
      color:var(--about-ink);
      font-size:16px;
      letter-spacing:0;
    }

    .logicItem p{
      margin:0;
      color:var(--about-muted);
      line-height:1.62;
    }

    .supportGrid{
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:12px;
    }

    .supportCard{
      overflow:hidden;
      border:1px solid var(--about-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 14px 34px rgba(17,31,67,.06);
    }

    .supportImage{
      aspect-ratio:16 / 10;
      overflow:hidden;
      background:#dce5f0;
    }

    .supportBody{
      padding:14px;
    }

    .supportBody h3{
      margin:0 0 8px;
      color:var(--about-ink);
      font-size:16px;
      letter-spacing:0;
    }

    .supportBody p{
      margin:0;
      color:var(--about-muted);
      font-size:13px;
      line-height:1.58;
    }

    .supportActions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-top:18px;
    }

    .lightBtn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-height:42px;
      padding:0 17px;
      border:1px solid rgba(35,101,255,.20);
      border-radius:8px;
      background:#fff;
      color:#2365ff;
      font-size:13px;
      font-weight:900;
    }

    .buyerCard{
      padding:20px;
      background:linear-gradient(180deg, #fff 0%, #f0f5ff 100%);
    }

    .principleBand{
      padding:26px;
      border-radius:8px;
      background:#071f43;
      color:#fff;
      box-shadow:0 18px 42px rgba(7,31,67,.18);
    }

    .principleBand h2{
      margin:0 0 18px;
      color:#fff;
      font-size:26px;
      letter-spacing:0;
    }

    .principleGrid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:12px;
    }

    .principleItem{
      min-height:150px;
      padding:18px;
      border:1px solid rgba(255,255,255,.14);
      border-radius:8px;
      background:rgba(255,255,255,.06);
    }

    .fitThinkGrid{
      display:grid;
      grid-template-columns:minmax(0, 1fr) minmax(360px, .98fr);
      gap:24px;
      align-items:stretch;
    }

    .ctaFlow{
      display:grid;
      grid-template-columns:repeat(5, minmax(0, 1fr));
      gap:10px;
      min-width:560px;
    }

    .ctaStep{
      position:relative;
      display:grid;
      justify-items:center;
      gap:9px;
      color:rgba(234,240,255,.82);
      font-size:12px;
      font-weight:850;
      line-height:1.25;
      text-align:center;
    }

    .ctaStep::after{
      content:"";
      position:absolute;
      top:19px;
      left:calc(50% + 24px);
      width:calc(100% - 38px);
      height:1px;
      background:rgba(255,255,255,.30);
    }

    .ctaStep:last-child::after{
      display:none;
    }

    .ctaIcon{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:38px;
      height:38px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.24);
      background:rgba(255,255,255,.08);
      color:#fff;
      font-size:12px;
      font-weight:950;
    }

    .principleIcon{
      width:38px;
      height:38px;
      margin-bottom:14px;
      color:#6fa0ff;
    }

    .principleItem h3{
      margin:0 0 8px;
      color:#fff;
      font-size:16px;
      letter-spacing:0;
    }

    .principleItem p{
      margin:0;
      color:rgba(234,240,255,.76);
      font-size:13px;
      line-height:1.58;
    }

    .faqGrid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:12px;
    }

    details{
      border:1px solid var(--about-line);
      border-radius:8px;
      background:#fff;
      box-shadow:0 12px 28px rgba(17,31,67,.05);
    }

    summary{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      min-height:56px;
      padding:0 18px;
      color:var(--about-ink);
      cursor:pointer;
      font-weight:900;
      list-style:none;
    }

    summary::-webkit-details-marker{
      display:none;
    }

    summary::after{
      content:"+";
      color:#2365ff;
      font-size:18px;
      font-weight:900;
    }

    details[open] summary::after{
      content:"-";
    }

    details p{
      margin:0;
      padding:0 18px 18px;
      color:var(--about-muted);
      line-height:1.65;
    }

    .finalCta{
      margin:8px 0 0;
      padding:28px;
      border-radius:8px;
      background:
        linear-gradient(90deg, rgba(7,31,67,.96), rgba(7,31,67,.82)),
        url("/images/insights/insights-topic-consolidation-logistics.webp") center/cover no-repeat;
      color:#fff;
      box-shadow:0 18px 42px rgba(7,31,67,.18);
    }

    .finalCtaInner{
      display:grid;
      grid-template-columns:minmax(0, .9fr) minmax(560px, 1.1fr);
      gap:28px;
      align-items:center;
    }

    .finalCta h2{
      margin:0 0 8px;
      color:#fff;
      font-size:28px;
      letter-spacing:0;
    }

    .finalCta p{
      margin:0;
      max-width:720px;
      color:rgba(234,240,255,.78);
      line-height:1.65;
    }

    .heroCopy,
    .controlPanel,
    .sectionBlock,
    .infoCard,
    .statementCard,
    .imagePanel,
    .pointRow,
    .workStep,
    .logicItem,
    .supportCard,
    .buyerCard,
    .principleBand,
    details,
    .finalCta{
      animation:aboutRise .64s ease both;
    }

    .controlPanel{ animation-delay:.10s; }
    .infoCard:nth-child(2),
    .statementCard:nth-child(2),
    .pointRow:nth-child(2),
    .workStep:nth-child(2),
    .logicItem:nth-child(2),
    .supportCard:nth-child(2),
    .buyerCard:nth-child(2),
    details:nth-child(2){ animation-delay:.06s; }
    .infoCard:nth-child(3),
    .statementCard:nth-child(3),
    .pointRow:nth-child(3),
    .workStep:nth-child(3),
    .logicItem:nth-child(3),
    .supportCard:nth-child(3),
    .buyerCard:nth-child(3),
    details:nth-child(3){ animation-delay:.12s; }
    .workStep:nth-child(4),
    .supportCard:nth-child(4),
    .buyerCard:nth-child(4),
    details:nth-child(4){ animation-delay:.18s; }

    @keyframes aboutRise{
      from{ opacity:0; transform:translateY(18px); }
      to{ opacity:1; transform:translateY(0); }
    }

    @media (prefers-reduced-motion: reduce){
      .heroCopy,
      .controlPanel,
      .sectionBlock,
      .infoCard,
      .statementCard,
      .imagePanel,
      .pointRow,
      .workStep,
      .logicItem,
      .supportCard,
      .buyerCard,
      .principleBand,
      details,
      .finalCta{
        animation:none !important;
      }
    }

    @media (max-width:1180px){
      .grid3,
      .supportGrid,
      .principleGrid{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .grid4{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .splitStage,
      .focusPanel,
      .founderPanel,
      .fitThinkGrid,
      .finalCtaInner{
        grid-template-columns:1fr;
      }

      .ctaFlow{
        min-width:0;
      }
    }

    @media (max-width:900px){
      .heroInner{
        grid-template-columns:1fr;
      }

      .heroInner{
        min-height:auto;
        padding:48px 0 34px;
      }

      .imagePanel{
        min-height:280px;
      }

      .workTrack{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .workStep::before{
        display:none;
      }

      .ctaFlow{
        grid-template-columns:repeat(3, minmax(0, 1fr));
      }

      .ctaStep::after{
        display:none;
      }
    }

    @media (max-width:680px){
      .heroCopy h1{
        font-size:38px;
      }

      .heroCopy p{
        font-size:16px;
      }

      .sectionBlock{
        padding:26px 0;
      }

      .sectionHeader{
        align-items:flex-start;
        flex-direction:column;
      }

      .grid3,
      .grid4,
      .supportGrid,
      .principleGrid,
      .workTrack,
      .ctaFlow,
      .faqGrid{
        grid-template-columns:1fr;
      }

      .finalCta{
        padding:22px;
      }
    }
  </style>

  <header class="aboutHero">
    <div class="container wide heroInner">
      <div class="heroCopy">
        <p class="eyebrow">About CertiSpares</p>
        <h1>Built for Commercial Vehicle RFQs That Need Sorting</h1>
        <p>
          CertiSpares helps importers, distributors, wholesalers, and fleet-related buyers turn incomplete truck parts
          inquiries into clearer matching scope, comparable supplier options, and controllable order execution.
        </p>
        <div class="heroActions">
          <a class="actionBtn primary" href="/contact?context=about-hero">Send RFQ <span aria-hidden="true">&rarr;</span></a>
          <a class="actionBtn" href="/capabilities">View Capabilities <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <aside class="controlPanel" aria-label="What CertiSpares controls before shipment">
        <h2>What We Control Before Shipment</h2>
        <div class="controlList">
          {controlItems.map((item) => (
            <div class="controlItem">
              <span class="controlIcon" aria-hidden="true"></span>
              <span>
                <strong>{item.title}</strong>
                <small>{item.text}</small>
              </span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </header>

  <main class="pageBody">
    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <div>
          <h2>Why CertiSpares Exists</h2>
        </div>
      </div>

      <div class="grid3">
        {existCards.map((card) => (
          <article class="infoCard">
            <span class="cardIcon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {iconPath[card.icon].map((path) => <path d={path}></path>)}
              </svg>
            </span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <div>
          <h2>What This Means in Practice</h2>
        </div>
      </div>

      <div class="grid3">
        {practiceCards.map((card) => (
          <article class="statementCard">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="splitStage">
        <div>
          <div class="sectionHeader">
            <div>
              <h2>Market Focus</h2>
            </div>
          </div>
          <div class="focusPanel">
            <div class="imagePanel">
              <img src="/images/insights/insights-platform-sourcing-overview.webp" alt="Commercial vehicle aftermarket parts sourcing scene" loading="eager" decoding="async" />
            </div>
            <div class="marketPoints">
              {marketPoints.map((point) => (
                <article class="pointRow">
                  <span class="pointMark" aria-hidden="true">✓</span>
                  <div>
                    <h3>{point.title}</h3>
                    <p>{point.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="workPanel">
          <div class="sectionHeader">
            <div>
              <h2>How We Work</h2>
            </div>
          </div>
          <div class="workTrack">
            {workSteps.map((step, index) => (
              <article class="workStep">
                <span class="workNumber">{String(index + 1).padStart(2, "0")}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="splitStage">
        <div>
          <div class="sectionHeader">
            <div>
              <h2>Founder Operating Logic</h2>
            </div>
          </div>
          <div class="founderPanel">
            <div class="imagePanel">
              <img src="/images/insights/insights-topic-rfq-clarification.webp" alt="RFQ review desk with sourcing notes" loading="eager" decoding="async" />
            </div>
            <div class="logicList">
              {founderCards.map((card) => (
                <article class="logicItem">
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div>
          <div class="sectionHeader">
            <div>
              <h2>What We Commonly Support</h2>
            </div>
          </div>
          <div class="supportGrid">
            {supportCards.map((card) => (
              <article class="supportCard">
                <div class="supportImage">
                  <img src={card.image} alt={`${card.title} sourcing support`} loading="eager" decoding="async" />
                </div>
                <div class="supportBody">
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </div>
              </article>
            ))}
          </div>
          <div class="supportActions">
            <a class="lightBtn" href="/product">View Parts RFQ <span aria-hidden="true">&rarr;</span></a>
            <a class="lightBtn" href="/capabilities">View Capabilities <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="fitThinkGrid">
        <div>
          <div class="sectionHeader">
            <div>
              <h2>Who This Model Fits</h2>
            </div>
          </div>
          <div class="grid4">
            {buyerCards.map((card) => (
              <article class="buyerCard">
                <span class="cardIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"></path></svg>
                </span>
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="principleBand">
          <h2>How We Think</h2>
          <div class="principleGrid">
            {principles.map((item, index) => (
              <article class="principleItem">
                <span class="principleIcon" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="sectionHeader">
        <div>
          <h2>FAQ</h2>
        </div>
      </div>

      <div class="faqGrid">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container wide sectionBlock">
      <div class="finalCta">
        <div class="finalCtaInner">
          <div>
            <h2>Have a truck parts RFQ that needs sorting?</h2>
            <p>
              Send the references you already have. We will review the matching scope first and reply with the next workable sourcing step.
            </p>
            <div class="heroActions">
              <a class="actionBtn primary" href="/contact?context=about-bottom">Send RFQ <span aria-hidden="true">&rarr;</span></a>
              <a class="actionBtn" href="/how-it-works">See How It Works <span aria-hidden="true">&rarr;</span></a>
            </div>
          </div>
          <div class="ctaFlow" aria-label="RFQ control path">
            {ctaSteps.map((step, index) => (
              <div class="ctaStep">
                <span class="ctaIcon">{String(index + 1).padStart(2, "0")}</span>
                <span>{step}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
